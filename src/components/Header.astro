---
import ThemeToggle from './ThemeToggle.astro';
import { sectionForHost, resolveNavHref, type NavLink } from '../lib/subdomains';

interface Props {
  currentPage?: string;
}
const { currentPage = 'home' } = Astro.props;

const host = Astro.request.headers.get('host');
// На поддомене раздела (sfl./yakk./blog.) подсвечиваем активный пункт по
// текущему хосту, а не по currentPage prop — на основном домене как раньше.
const currentSection = sectionForHost(host);

// Pill-сегмент в шапке — только 3 раздела, как в макете. Остальные пункты
// (Главная — через логотип, Сообщество/Инструменты) переехали на главную
// и в футер, в шапке больше не дублируются.
const pillLinkDefs: NavLink[] = [
  { slug: 'codex',    targetSection: 'sfl', path: '/codex',    label: 'Sunflower Land' },
  { slug: 'yakkamon', targetSection: 'yakk',path: '/yakkamon', label: 'Yakkamon'       },
  { slug: 'news',     targetSection: 'blog',path: '/news',     label: 'Новости и блог' },
];

const pillLinks = pillLinkDefs.map(link => ({
  slug: link.slug,
  label: link.label,
  href: resolveNavHref(host, link),
  active: currentSection?.id === link.targetSection,
}));

const logoHref = resolveNavHref(host, { slug: 'home', targetSection: null, path: '/', label: 'Главная' });

// Мобильное меню — полный список, ширина экрана здесь не ограничивает
// количество пунктов так, как в десктопном pill-сегменте.
const mobileLinkDefs: NavLink[] = [
  { slug: 'home',      targetSection: null,  path: '/',          label: 'Главная'        },
  { slug: 'codex',     targetSection: 'sfl', path: '/codex',     label: 'Sunflower Land' },
  { slug: 'yakkamon',  targetSection: 'yakk',path: '/yakkamon',  label: 'Yakkamon'       },
  { slug: 'news',      targetSection: 'blog',path: '/news',      label: 'Новости и блог' },
  { slug: 'community', targetSection: null,  path: '/community', label: 'Сообщество'     },
  { slug: 'tools',     targetSection: null,  path: '/tools',     label: 'Инструменты'    },
  { slug: 'about',     targetSection: null,  path: '/about',     label: 'О проекте'      },
];

const mobileLinks = mobileLinkDefs.map(link => ({
  slug: link.slug,
  label: link.label,
  href: resolveNavHref(host, link),
  active: currentSection ? link.targetSection === currentSection.id : currentPage === link.slug,
}));
---

<header class="gc-header">
  <div class="gc-header-inner">

    <a href={logoHref} class="gc-logo">
      <div class="gc-logo-icon">🧙</div>
      <span class="gc-logo-text">Goblin<span>Codex</span></span>
    </a>

    <nav class="gc-nav-pill">
      {pillLinks.map(link => (
        <a
          href={link.href}
          class={`gc-nav-pill-link gc-nav-pill-link--${link.slug}${link.active ? ' active' : ''}`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="gc-header-right">
      <a href="/about" class="gc-nav-ghost-link">
        О проекте
      </a>
      <a href="/donate" class="gc-btn-donate">
        Поддержать
      </a>
      <ThemeToggle />
    </div>

    <!-- Мобильный хедер: кнопка темы + гамбургер -->
    <div class="gc-mobile-controls">
      <ThemeToggle />
      <button class="gc-hamburger" id="hamburger" aria-label="Меню">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

  </div>

  <!-- Мобильное меню -->
  <div class="gc-mobile-menu" id="mobileMenu" aria-hidden="true">
    {mobileLinks.map(link => (
      <a
        href={link.href}
        class={link.active ? 'active' : ''}
      >
        {link.label}
      </a>
    ))}
    <div class="gc-mobile-menu-footer">
      <a href="/donate" class="gc-btn-donate gc-btn-donate--full">
        Поддержать
      </a>
    </div>
  </div>

</header>

<script>
  import { initThemeToggle } from '../lib/theme';

  const hamburger        = document.getElementById('hamburger');
  const mobileMenu       = document.getElementById('mobileMenu');

  initThemeToggle();

  // ── Гамбургер ──
  let menuOpen = false;

  hamburger?.addEventListener('click', () => {
    menuOpen = !menuOpen;
    hamburger.classList.toggle('open', menuOpen);
    mobileMenu!.style.display = menuOpen ? 'block' : 'none';
    mobileMenu!.setAttribute('aria-hidden', menuOpen ? 'false' : 'true');
  });

  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menuOpen = false;
      hamburger?.classList.remove('open');
      mobileMenu.style.display = 'none';
      mobileMenu.setAttribute('aria-hidden', 'true');
    });
  });

  document.addEventListener('click', (e) => {
    if (menuOpen && !mobileMenu!.contains(e.target as Node) && !hamburger!.contains(e.target as Node)) {
      menuOpen = false;
      hamburger?.classList.remove('open');
      mobileMenu!.style.display = 'none';
      mobileMenu!.setAttribute('aria-hidden', 'true');
    }
  });
</script>