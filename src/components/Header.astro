---
interface Props {
  currentPage?: string;
}
const { currentPage = 'home' } = Astro.props;

const navLinks = [
  { slug: 'home',      href: '/',          label: 'Главная'     },
  { slug: 'codex',    href: '/codex',    label: 'База знаний' },
  { slug: 'news',      href: '/news',      label: 'Новости'     },
  { slug: 'community', href: '/community', label: 'Сообщество'  },
  { slug: 'tools',     href: '/tools',     label: 'Инструменты' },
  { slug: 'about',     href: '/about',     label: 'О проекте'   },
  { slug: 'donate',    href: '/donate',    label: 'Поддержать'  },
];
---

<header class="gc-header">
  <div class="gc-header-inner">

    <a href="/" class="gc-logo">
      <div class="gc-logo-icon">🧙</div>
      <span class="gc-logo-text">Goblin<span>Codex</span></span>
    </a>

    <nav class="gc-nav">
      {navLinks.filter(l => l.slug !== 'donate').map(link => (
        <a
          href={link.href}
          class={`gc-nav-link${currentPage === link.slug ? ' active' : ''}`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="gc-header-right">
      <button class="gc-icon-btn" id="themeToggle" title="Сменить тему" aria-label="Сменить тему">
        <span id="themeIcon">☀️</span>
      </button>
      <a href="https://t.me/URGSFL" target="_blank" rel="noopener" class="gc-btn-telegram">
        Telegram
      </a>
      <a href="/donate" class="gc-btn-donate">
        Поддержать
      </a>
    </div>

    <!-- Мобильный хедер: кнопка темы + гамбургер -->
    <div class="gc-mobile-controls">
      <button class="gc-icon-btn" id="themeToggleMobile" title="Сменить тему" aria-label="Сменить тему">
        <span id="themeIconMobile">☀️</span>
      </button>
      <button class="gc-hamburger" id="hamburger" aria-label="Меню">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

  </div>

  <!-- Мобильное меню -->
  <div class="gc-mobile-menu" id="mobileMenu" aria-hidden="true">
    {navLinks.map(link => (
      <a
        href={link.href}
        class={currentPage === link.slug ? 'active' : ''}
      >
        {link.label}
      </a>
    ))}
    <div class="gc-mobile-menu-footer">
      <a href="https://t.me/URGSFL" target="_blank" rel="noopener" class="gc-btn-telegram gc-btn-telegram--full">
        Telegram
      </a>
    </div>
  </div>

</header>

<script>
  const html             = document.documentElement;
  const hamburger        = document.getElementById('hamburger');
  const mobileMenu       = document.getElementById('mobileMenu');
  const themeToggle      = document.getElementById('themeToggle');
  const themeIcon        = document.getElementById('themeIcon');
  const themeToggleMob   = document.getElementById('themeToggleMobile');
  const themeIconMob     = document.getElementById('themeIconMobile');

  // ── Тема ──
  const saved = JSON.parse(localStorage.getItem('gcSettings') || '{}');
  let isDark = saved.theme === 'dark';

  const applyTheme = () => {
    html.setAttribute('data-theme', isDark ? 'dark' : '');
    const icon = isDark ? '🌙' : '☀️';
    if (themeIcon)    themeIcon.textContent    = icon;
    if (themeIconMob) themeIconMob.textContent = icon;
    localStorage.setItem('gcSettings', JSON.stringify({ ...saved, theme: isDark ? 'dark' : 'light' }));
  };

  applyTheme();

  const toggleTheme = () => { isDark = !isDark; applyTheme(); };
  themeToggle?.addEventListener('click', toggleTheme);
  themeToggleMob?.addEventListener('click', toggleTheme);

  // ── Гамбургер ──
  let menuOpen = false;

  hamburger?.addEventListener('click', () => {
    menuOpen = !menuOpen;
    hamburger.classList.toggle('open', menuOpen);
    mobileMenu!.style.display = menuOpen ? 'block' : 'none';
    mobileMenu!.setAttribute('aria-hidden', menuOpen ? 'false' : 'true');
  });

  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menuOpen = false;
      hamburger?.classList.remove('open');
      mobileMenu.style.display = 'none';
      mobileMenu.setAttribute('aria-hidden', 'true');
    });
  });

  document.addEventListener('click', (e) => {
    if (menuOpen && !mobileMenu!.contains(e.target as Node) && !hamburger!.contains(e.target as Node)) {
      menuOpen = false;
      hamburger?.classList.remove('open');
      mobileMenu!.style.display = 'none';
      mobileMenu!.setAttribute('aria-hidden', 'true');
    }
  });
</script>