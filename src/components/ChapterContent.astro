---
// Общий контент главы (баннер, механики, гайды, предметы, аукционы) —
// подключается как таб внутри /codex?tab=chapter. Показывает ВСЕ аукционы
// текущей главы (и уже прошедшие, и предстоящие/активные) — архив всех
// остальных глав целиком живёт на /codex/chapter/[slug].
import { getCollection } from 'astro:content';
import ChapterAuctionTabs from './ChapterAuctionTabs.tsx';
import ChapterTicketLeaderboard from './ChapterTicketLeaderboard.tsx';
import { getCurrentChapter, getUpcomingChapter } from '../lib/chapters';
import { MUTANT_CRAFT_ITEMS, STELLA_ITEMS } from '../lib/chapterItemGroups';
import { fetchAuctionsInRange, type UiAuction } from '../lib/auctionsApi';
import type { getCatalogItems } from '../lib/db';
import { getCachedCatalogItems } from '../lib/catalog-cache';
import { sectionHref } from '../lib/subdomains';

// Каталог предметов можно передать пропом — страница /codex забирает его в
// одном общем параллельном батче с остальными источниками (иначе вкладка
// глава добавляла бы свой последовательный DB-раунд к SSR). Проп не
// передан — грузим сами, как раньше.
interface Props {
  itemCatalog?: Record<string, Awaited<ReturnType<typeof getCatalogItems>>[number]>;
}
const { itemCatalog: itemCatalogProp } = Astro.props;

const currentChapter = getCurrentChapter();
// За две недели до старта следующей главы показываем её предметы отдельным блоком.
const upcomingChapter = getUpcomingChapter();

// Компонент подключается и на /chapter основного домена, и внутри /codex.
// Когда поддомены включены (см. src/lib/subdomains.ts), ссылки на гайды
// становятся абсолютными на sfl.* — иначе это просто /codex того же домена.
const codexHref = sectionHref(Astro.request.headers.get('host'), 'sfl', '/codex');

// Каталог нужен только для блока "Предметы главы" — аукционы теперь тянут
// свои данные сами (см. ChapterAuctions, /api/auctions/chapter.json), чтобы
// расписание + itemCatalog не ехали пропсами в HTML каждого просмотра /codex.
let itemCatalog: Record<string, Awaited<ReturnType<typeof getCatalogItems>>[number]> = itemCatalogProp ?? {};
if (!itemCatalogProp) {
  try {
    const { data: items } = await getCachedCatalogItems();
    itemCatalog = Object.fromEntries(items.map((i) => [i.name, i]));
  } catch (err) {
    console.error('[ChapterContent] DB fetch error:', err);
  }
}

const chapterGuides = await getCollection(
  'guides',
  ({ data }) => !data.draft && data.chapter === currentChapter?.order
);
chapterGuides.sort((a, b) => new Date(b.data.publishDate ?? '').getTime() - new Date(a.data.publishDate ?? '').getTime());

const itemsOf = (slug: string) =>
  Object.values(itemCatalog)
    // Баннер главы в списке предметов не показываем — он декоративный.
    .filter((i) => i.tags?.includes(`chapter-${slug}`) && !i.name.endsWith(' Banner'))
    .sort((a, b) => a.name.localeCompare(b.name));
const chapterItems = currentChapter ? itemsOf(currentChapter.slug) : [];
const upcomingItems = upcomingChapter ? itemsOf(upcomingChapter.slug) : [];

// Расписание аукционов главы — сервером, для блока «Предметы с аукционов».
// fetchAuctionsInRange кэширует ответ goblin-api в процессе (10 мин), при ошибке
// сети возвращает [] — блок просто не отрисуется.
let chapterAuctionList: UiAuction[] = [];
if (currentChapter) {
  chapterAuctionList = await fetchAuctionsInRange(
    new Date(currentChapter.startDate).getTime(),
    new Date(currentChapter.endDate).getTime(),
  );
}
const upcomingStart = upcomingChapter
  ? new Date(upcomingChapter.startDate).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', timeZone: 'UTC' })
  : '';

// Разбивка предметов главы на группы (см. src/lib/chapterItemGroups.ts):
// аукционные — по живому расписанию аукционов, мутанты/крафт — по списку
// из кода игры, остальные считаем магазином Стеллы (покупка за тикеты).
const auctionItemNames = new Set(
  chapterAuctionList
    .map((a) => a.collectible ?? a.wearable ?? a.nft)
    .filter((n): n is string => Boolean(n))
);
const mutantItemNames = new Set(MUTANT_CRAFT_ITEMS[currentChapter?.slug ?? ''] ?? []);
const stellaItemNames = new Set(STELLA_ITEMS[currentChapter?.slug ?? ''] ?? []);
// Аукционные предметы — ВСЕ из живого расписания (отдельный блок «Предметы
// с аукционов» убран как дубль): берём и тегированные предметы главы, и
// нетегированные (новинки главы часто попадают в расписание раньше, чем в
// теги БД). NFT-питомцев в каталоге нет — они просто не попадут в сетку.
const auctionGroup = [
  ...chapterItems.filter((i) => auctionItemNames.has(i.name)),
  ...[...auctionItemNames]
    .filter((n) => !chapterItems.some((i) => i.name === n))
    .map((n) => itemCatalog[n])
    .filter((i): i is NonNullable<typeof i> => Boolean(i)),
].sort((a, b) => a.name.localeCompare(b.name));
const mutantGroup = chapterItems.filter((i) => !auctionItemNames.has(i.name) && mutantItemNames.has(i.name));
// Stella — по явному списку из megastore.ts кода игры: часть предметов
// (хоургласы, Pot of Luck) в нашей БД без тега главы, поэтому берём их
// из каталога напрямую по имени. Плюс тегированные предметы главы, не
// попавшие в аукционы/мутантов/явный список (страховка на новые добавки).
const stellaGroup = [
  ...[...stellaItemNames]
    .map((n) => itemCatalog[n])
    .filter((i): i is NonNullable<typeof i> => Boolean(i) && !auctionItemNames.has(i.name)),
  ...chapterItems.filter(
    (i) =>
      !auctionItemNames.has(i.name) &&
      !mutantItemNames.has(i.name) &&
      !stellaItemNames.has(i.name)
  ),
].sort((a, b) => a.name.localeCompare(b.name));
const itemGroups = [
  { id: 'stella', icon: '🏪', title: 'Stella — за тикеты главы', items: stellaGroup },
  { id: 'auctions', icon: '🔨', title: 'Аукционы', items: auctionGroup },
  { id: 'mutants', icon: '🧬', title: 'Мутанты и крафт', items: mutantGroup },
].filter((g) => g.items.length > 0);

// Карточки-кнопки, открывающие гайд по механике в модалке —
// сама модалка вынесена в отдельный ChapterMechanicModal.astro
// (см. src/pages/chapter.astro и src/pages/codex/index.astro).
const MECHANIC_CARDS = [
  { id: 'delivery',     icon: '🚚', title: 'Доставки' },
  { id: 'auction',      icon: '🔨', title: 'Аукционы' },
  { id: 'raffle',       icon: '🎟️', title: 'Рафлы' },
  { id: 'bounty-board', icon: '📋', title: 'Баунтиборд' },
  { id: 'chore',        icon: '✅', title: 'Chore (задания)' },
  { id: 'chapter-pass', icon: '🎫', title: 'Чаптерпасс' },
];
---

<!-- ── Архивы и аналитика — важные разделы главы, поэтому крупные карточки ── -->
<div class="gc-chapter-archive-links">
  <a href="/codex/chapter/past" class="gc-archive-card">
    <span class="gc-archive-card-icon">📜</span>
    <span class="gc-archive-card-body">
      <span class="gc-archive-card-title">Прошлые главы</span>
      <span class="gc-archive-card-desc">Предметы и аукционы архива</span>
    </span>
  </a>
  <a href="/codex?tab=chapter&auktab=history" class="gc-archive-card">
    <span class="gc-archive-card-icon">🕘</span>
    <span class="gc-archive-card-body">
      <span class="gc-archive-card-title">История аукционов</span>
      <span class="gc-archive-card-desc">Все завершённые ставки</span>
    </span>
  </a>
  <a href="/codex?tab=chapter&auktab=tiers" class="gc-archive-card">
    <span class="gc-archive-card-icon">📊</span>
    <span class="gc-archive-card-body">
      <span class="gc-archive-card-title">Тиры аукционов</span>
      <span class="gc-archive-card-desc">Медианы и разбор по тирам</span>
    </span>
  </a>
</div>

<!-- ── Центр аукционов: расписание / история / тиры в одном блоке ── -->
<section class="gc-chapter-section">
  <h2 class="gc-block-title-lg">🔨 Аукционы</h2>
  <ChapterAuctionTabs client:visible chapterName={currentChapter?.name ?? 'текущей главы'} />
</section>

<!-- ── Лидерборд билетов с пометками о выигранных предметах ── -->
<section class="gc-chapter-section">
  <ChapterTicketLeaderboard client:visible />
</section>

{upcomingChapter && (
  <section class="gc-chapter-section">
    <a href={`/codex/chapter/${upcomingChapter.slug}`} class="gc-card gc-card-hover gc-chapter-upcoming">
      <span class="gc-chapter-upcoming-icon">🔜</span>
      <span class="gc-chapter-upcoming-body">
        <span class="gc-chapter-upcoming-title">Скоро: глава {upcomingChapter.order} — {upcomingChapter.name}</span>
        <span class="gc-chapter-upcoming-desc">
          Старт {upcomingStart}. Валюта главы — {upcomingChapter.ticket}, артефакт — {upcomingChapter.artifact}.
          {upcomingItems.length > 0 ? ` Уже известно предметов: ${upcomingItems.length}.` : ''} Предметы и аукционы новой главы →
        </span>
      </span>
    </a>
  </section>
)}

<!-- ── Предметы главы: аккордеон по источникам (Stella / аукционы / мутанты) ── -->
<section class="gc-chapter-section">
  <h2 class="gc-block-title-lg">💎 Предметы главы</h2>
  {itemGroups.length > 0 ? (
    <div class="gc-item-groups">
      {itemGroups.map((group, gi) => (
        <details class="gc-item-group" open={gi === 0}>
          <summary class="gc-item-group-summary">
            <span class="gc-item-group-icon">{group.icon}</span>
            {group.title}
            <span class="gc-item-group-count">{group.items.length}</span>
          </summary>
          <div class="gc-chapter-items-grid">
            {group.items.map((item) => (
              <div class="gc-chapter-item-card">
                <div class="gc-chapter-item-sprite">
                  {item.sprite ? (
                    <img src={`/sprites/${item.sprite}`} alt={item.name} loading="lazy" />
                  ) : (
                    <span class="gc-chapter-item-sprite-placeholder">?</span>
                  )}
                </div>
                <div class="gc-chapter-item-info">
                  <div class="gc-chapter-item-name">{item.name}</div>
                  {item.boosts.length > 0 ? (
                    <div class="gc-chapter-item-boosts">
                      {item.boosts.map((b) => (
                        <span class={`gc-chapter-item-boost gc-chapter-item-boost--${b.labelType}`}>
                          {b.shortDescriptionRu || b.shortDescription}
                        </span>
                      ))}
                    </div>
                  ) : (
                    <span class="gc-chapter-item-no-boost">Без бонусов</span>
                  )}
                </div>
              </div>
            ))}
          </div>
        </details>
      ))}
    </div>
  ) : (
    <div class="gc-guides-empty">
      Каталог предметов главы скоро появится здесь — данные будут подгружаться из базы.
    </div>
  )}
</section>

<!-- ── Гайды по механике главы — показываем, только когда они есть ── -->
{chapterGuides.length > 0 && (
  <section class="gc-chapter-section">
    <h2 class="gc-block-title-lg">📗 Гайды по механике главы</h2>
    <div class="gc-guides-grid">
      {chapterGuides.map(guide => (
        <a href={`${codexHref}/${guide.id}`} class="gc-card gc-card-hover gc-guide-card">
          <div class="gc-guide-card-top">
            <div class="gc-guide-card-icon">{guide.data.icon}</div>
            <div class="gc-guide-card-info">
              <div class="gc-guide-card-title">{guide.data.title}</div>
              <div class="gc-guide-card-meta">
                <span class="gc-tag gc-tag--green">{guide.data.category}</span>
                <span class="gc-guide-card-time">⏱ {guide.data.readTime} мин</span>
              </div>
            </div>
          </div>
          <div class="gc-guide-card-desc">{guide.data.description}</div>
        </a>
      ))}
    </div>
  </section>
)}

<!-- ── Основные механики: справка для новичков, свёрнута по умолчанию ── -->
<details class="gc-mech-details">
  <summary class="gc-mech-summary">
    ⚙️ Основные механики
    <span class="gc-mech-hint">справка для новичков</span>
  </summary>
  <div class="gc-mechanics-grid">
    {MECHANIC_CARDS.map(card => (
      <button type="button" class="gc-mechanic-card" data-mech-open={card.id}>
        <div class="gc-mechanic-icon">{card.icon}</div>
        <div class="gc-mechanic-title">{card.title}</div>
      </button>
    ))}
  </div>
</details>

<style>
.gc-chapter-section { margin-bottom: 40px; }
.gc-chapter-upcoming {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 18px 20px;
  text-decoration: none;
  color: var(--text);
}
.gc-chapter-upcoming-icon {
  font-size: 28px;
  flex-shrink: 0;
}
.gc-chapter-upcoming-body {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.gc-chapter-upcoming-title {
  font-family: var(--font-head);
  font-size: 17px;
  font-weight: 700;
}
.gc-chapter-upcoming-desc {
  font-size: 14px;
  color: var(--text-sec);
}
.gc-chapter-archive-links {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  margin-bottom: 32px;
}
.gc-archive-card {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px 18px;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
  text-decoration: none;
  transition: border-color 0.15s, transform 0.15s;
}
.gc-archive-card:hover {
  border-color: var(--green-mid);
  transform: translateY(-2px);
}
.gc-archive-card-icon {
  font-size: 24px;
  width: 46px;
  height: 46px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--green-pale);
  border-radius: 10px;
}
.gc-archive-card-body {
  display: flex;
  flex-direction: column;
  gap: 3px;
  min-width: 0;
}
.gc-archive-card-title {
  font-size: 14px;
  font-weight: 700;
  color: var(--text);
}
.gc-archive-card-desc {
  font-size: 12px;
  color: var(--text-sec);
}
@media (max-width: 640px) {
  .gc-chapter-archive-links { grid-template-columns: 1fr; }
}

/* ── Основные механики: сворачиваемый блок для новичков ── */
.gc-mech-details {
  margin-bottom: 40px;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 0;
}
.gc-mech-summary {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 16px 20px;
  font-family: var(--font-head);
  font-size: 15px;
  font-weight: 700;
  color: var(--text-sec);
  cursor: pointer;
  list-style: none;
  user-select: none;
}
.gc-mech-summary::-webkit-details-marker { display: none; }
.gc-mech-summary::before {
  content: '▸';
  display: inline-block;
  transition: transform 0.15s;
  color: var(--text-ter);
}
.gc-mech-details[open] .gc-mech-summary::before { transform: rotate(90deg); }
.gc-mech-details[open] .gc-mech-summary { color: var(--text); }
.gc-mech-hint {
  font-size: 12px;
  font-weight: 400;
  color: var(--text-ter);
}
.gc-mech-details .gc-mechanics-grid {
  padding: 0 20px 20px;
}
.gc-block-title-lg {
  font-family: var(--font-head);
  font-size: 18px;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 16px;
}

/* ── Основные механики ── */
.gc-mechanics-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 16px;
}
.gc-mechanic-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  padding: 20px 12px;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
  text-align: center;
  cursor: pointer;
  font: inherit;
  transition: border-color 0.15s, transform 0.15s;
}
.gc-mechanic-card:hover {
  border-color: var(--green-mid);
  transform: translateY(-2px);
}
.gc-mechanic-icon {
  font-size: 28px;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--green-pale);
  border-radius: 10px;
}
.gc-mechanic-title {
  font-size: 12px;
  font-weight: 600;
  color: var(--text);
  line-height: 1.4;
}
@media (max-width: 900px) {
  .gc-mechanics-grid { grid-template-columns: repeat(3, 1fr) !important; }
}
@media (max-width: 640px) {
  .gc-mechanics-grid { grid-template-columns: repeat(2, 1fr) !important; }
}

/* ── Сетка гайдов (как в /codex) ── */
.gc-guides-empty {
  padding: 32px;
  text-align: center;
  color: var(--text-sec);
  font-size: 14px;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
}
.gc-guides-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}
.gc-guide-card {
  text-decoration: none;
  color: var(--text);
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.gc-guide-card-top {
  display: flex;
  align-items: flex-start;
  gap: 14px;
}
.gc-guide-card-icon {
  font-size: 28px;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--green-pale);
  border-radius: 10px;
}
.gc-guide-card-info { flex: 1; }
.gc-guide-card-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 6px;
  line-height: 1.4;
}
.gc-guide-card-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.gc-guide-card-time { font-size: 11px; color: var(--text-sec); }
.gc-guide-card-desc { font-size: 12px; color: var(--text-sec); line-height: 1.5; }

@media (max-width: 900px) {
  .gc-guides-grid { grid-template-columns: repeat(2, 1fr) !important; }
}
@media (max-width: 640px) {
  .gc-guides-grid { grid-template-columns: 1fr !important; }
}

/* ── Предметы главы ── */
.gc-item-groups {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.gc-item-group {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
}
.gc-item-group-summary {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 20px;
  font-family: var(--font-head);
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
  cursor: pointer;
  list-style: none;
  user-select: none;
}
.gc-item-group-summary::-webkit-details-marker { display: none; }
.gc-item-group-summary::before {
  content: '▸';
  display: inline-block;
  transition: transform 0.15s;
  color: var(--text-ter);
}
.gc-item-group[open] .gc-item-group-summary::before { transform: rotate(90deg); }
.gc-item-group-icon { font-size: 20px; }
.gc-item-group-count {
  margin-left: auto;
  font-size: 12px;
  font-weight: 700;
  color: var(--text-sec);
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 3px 10px;
}
.gc-item-group .gc-chapter-items-grid {
  padding: 4px 16px 18px;
}

.gc-chapter-items-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 14px;
}
.gc-chapter-item-card {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 14px;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
}
.gc-chapter-item-sprite {
  width: 44px;
  height: 44px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg);
  border-radius: 8px;
}
.gc-chapter-item-sprite img {
  width: 36px;
  height: 36px;
  object-fit: contain;
  image-rendering: pixelated;
}
.gc-chapter-item-sprite-placeholder {
  color: var(--text-ter);
  font-size: 16px;
}
.gc-chapter-item-info {
  flex: 1;
  min-width: 0;
}
.gc-chapter-item-name {
  font-size: 13px;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 6px;
}
.gc-chapter-item-boosts {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}
.gc-chapter-item-boost {
  font-size: 10px;
  font-weight: 600;
  padding: 2px 7px;
  border-radius: 5px;
  background: var(--green-pale);
  color: var(--green-dark);
}
.gc-chapter-item-boost--danger {
  background: color-mix(in srgb, var(--red, #c94b3d) 14%, transparent);
  color: var(--red, #c94b3d);
}
.gc-chapter-item-boost--vibrant {
  background: var(--amber-pale);
  color: var(--amber);
}
.gc-chapter-item-no-boost {
  font-size: 11px;
  color: var(--text-ter);
}
</style>

<script>
  // Кнопки "Основные механики" только открывают модалку — сама модалка и её
  // логика вынесены в ChapterMechanicModal.astro, подключённый отдельно
  // рядом с этим компонентом (см. src/pages/chapter.astro и codex/index.astro).
  const mechButtons = document.querySelectorAll<HTMLButtonElement>('[data-mech-open]');
  mechButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.mechOpen;
      if (id) window.dispatchEvent(new CustomEvent('gc:open-mech-modal', { detail: id }));
    });
  });
</script>
