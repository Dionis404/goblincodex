---
const navLinks = [
  { href: '/guides',    label: 'Гайды'      },
  { href: '/news',      label: 'Новости'    },
  { href: '/tools',     label: 'Инструменты'},
  { href: '/community', label: 'Сообщество' },
  { href: '/donate',    label: 'Поддержать' },
];
---

<footer class="gc-footer">
  <div class="gc-footer-inner">

    <div class="gc-footer-brand">
      <a href="/" class="gc-logo">
        <div class="gc-logo-icon">🧙</div>
        <div>
          <span class="gc-logo-text">Goblin<span>Codex</span></span>
          <p class="gc-footer-tagline">фан-сайт по Sunflower Land</p>
        </div>
      </a>
    </div>

    <nav class="gc-footer-nav">
      {navLinks.map(link => (
        <a href={link.href} class="gc-footer-link">{link.label}</a>
      ))}
    </nav>

    <div class="gc-footer-copy">
      <p>© 2026 GoblinCodex</p>
      <p>Не аффилирован с Sunflower Land</p>
    </div>

  </div>
</footer>