---
interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  shareUrl?: string;
}

const {
  title,
  description,
  image = '/og-default.png',
  type = 'website',
  noindex = false,
  shareUrl,
} = Astro.props;

// Astro.url.origin у @astrojs/node в standalone-режиме отражает адрес, на
// котором слушает сам сервер (localhost:4321), а НЕ заголовок Host запроса —
// поэтому origin строим из заголовка Host вручную. Это важно для
// blog.goblincodex.fun/.ru, которые отдают контент под собственным доменом
// через тот же сервис (см. src/pages/news.astro + src/middleware.ts):
// canonical/OG-ссылки должны указывать на blog.*, а не всегда на localhost/goblincodex.fun.
const requestHost = Astro.request.headers.get('host');
const requestOrigin = requestHost ? `${Astro.url.protocol}//${requestHost}` : Astro.url.origin;
const canonicalURL = new URL(Astro.url.pathname, requestOrigin);
// og:url обычно совпадает с canonical, но для страниц с "виртуальными"
// query-параметрами (?article=slug на /news — отдельная сущность в глазах
// шаринга, хоть и не отдельный маршрут) нужен явный shareUrl, иначе
// Telegram/соцсети привяжут превью к общему URL страницы, а не к статье.
const ogURL = shareUrl ? new URL(shareUrl, requestOrigin) : canonicalURL;
const imageURL = new URL(image, requestOrigin);
const siteName = 'Goblin Codex';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": type === 'article' ? 'Article' : 'WebSite',
  "name": title,
  "description": description,
  "url": ogURL.toString(),
  "image": imageURL.toString(),
  "inLanguage": "ru",
  "publisher": {
    "@type": "Organization",
    "name": "GoblinCodex",
    "url": "https://goblincodex.fun"
  }
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:url" content={ogURL} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="ru_RU" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
