---
import { sectionForHost, mainDomainFor } from '../lib/subdomains';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  shareUrl?: string;
}

const {
  title,
  description,
  // ?v= — сброс кэша Cloudflare и соцсетей при замене обложки (меняйте цифру).
  image = '/og-default.png?v=2',
  type = 'website',
  noindex = false,
  shareUrl,
} = Astro.props;

// Astro.url.origin у @astrojs/node в standalone-режиме отражает адрес, на
// котором слушает сам сервер (localhost:4321), а НЕ заголовок Host запроса —
// поэтому origin строим из заголовка Host вручную. Это важно для
// blog.goblincodex.fun/.ru, которые отдают контент под собственным доменом
// через тот же сервис (см. src/pages/news.astro + src/middleware.ts):
// canonical/OG-ссылки должны указывать на blog.*, а не всегда на localhost/goblincodex.fun.
// Протокол всегда https: за Cloudflare TLS-трафик до Node приходит plain
// HTTP (Astro.url.protocol видит "http:"), а http:// в og:image/og:url
// не по всем сайтам грузится в превью Telegram/соцсетей.
const requestHost = Astro.request.headers.get('host');
// Страницы основного домена (/tools, /about, …) открываются и на любом
// поддомене раздела — без этого у каждой было бы 4 разных canonical
// (дубли для поисковиков). Свой поддомен оставляем только путям раздела.
const hostSection = sectionForHost(requestHost);
const isOwnSectionPath = hostSection
  && (Astro.url.pathname === hostSection.path || Astro.url.pathname.startsWith(`${hostSection.path}/`));
const canonicalHost = hostSection && !isOwnSectionPath ? mainDomainFor(requestHost) : requestHost;
// goblincodex.ru (и его поддомены) — запасное зеркало: сайт там полностью
// работает и ссылки остаются на .ru, но для поисковиков главный адрес
// всегда на .fun, иначе .ru и .fun конкурируют в выдаче как дубли.
const requestOrigin = canonicalHost
  ? `https://${canonicalHost.replace(/goblincodex\.ru(:\d+)?$/, 'goblincodex.fun')}`
  : Astro.url.origin;
const canonicalURL = new URL(Astro.url.pathname, requestOrigin);
// og:url обычно совпадает с canonical, но для страниц с "виртуальными"
// query-параметрами (?article=slug на /news — отдельная сущность в глазах
// шаринга, хоть и не отдельный маршрут) нужен явный shareUrl, иначе
// Telegram/соцсети привяжут превью к общему URL страницы, а не к статье.
const ogURL = shareUrl ? new URL(shareUrl, requestOrigin) : canonicalURL;
const imageURL = new URL(image, requestOrigin);
const siteName = 'Goblin Codex';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": type === 'article' ? 'Article' : 'WebSite',
  "name": title,
  "description": description,
  "url": ogURL.toString(),
  "image": imageURL.toString(),
  "inLanguage": "ru",
  "publisher": {
    "@type": "Organization",
    "name": "GoblinCodex",
    "url": "https://goblincodex.fun"
  }
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
{image.startsWith('/og-default.png') && (
  <>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="GoblinCodex — русскоязычный хаб по Sunflower Land" />
  </>
)}
<meta property="og:url" content={ogURL} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="ru_RU" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
