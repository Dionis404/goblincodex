---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import CommunityPage from '../components/CommunityPage.jsx';
import { getCollection } from 'astro:content';

let farmers: any[] = [];
let apiError = false;

try {
  const res = await fetch('http://goblin-api:8000/community/farmers');
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  farmers = await res.json();
} catch (e) {
  apiError = true;
  console.error('Community API error:', e);
}

// Build username → { authored, contributed } map from content collection
const allGuides = await getCollection('guides');
const guidesByUser: Record<string, { authored: any[]; contributed: any[] }> = {};

for (const guide of allGuides) {
  if (guide.data.draft) continue;
  const { author, contributors, title, icon } = guide.data;
  const info = { id: guide.id, title, icon };

  if (author) {
    const k = author.toLowerCase();
    guidesByUser[k] ??= { authored: [], contributed: [] };
    guidesByUser[k].authored.push(info);
  }
  for (const name of contributors ?? []) {
    const k = name.toLowerCase();
    guidesByUser[k] ??= { authored: [], contributed: [] };
    guidesByUser[k].contributed.push(info);
  }
}
---

<BaseLayout
  title="Сообщество — GoblinCodex"
  description="Фермеры GoblinCodex, привязавшие свою ферму Sunflower Land через бота."
  currentPage="community"
>
  <div class="gc-content gc-page-enter">

    <div class="gc-community-header">
      <h1 class="gc-page-title">👥 Сообщество GoblinCodex</h1>
      <p class="gc-community-sub">Фермеры, привязавшие ферму через бота</p>
    </div>

    {apiError ? (
      <div class="gc-community-error gc-card">
        ⚠️ Данные временно недоступны. Попробуйте позже.
      </div>
    ) : (
      <CommunityPage client:load farmers={farmers} guidesByUser={guidesByUser} />
    )}

  </div>
</BaseLayout>
