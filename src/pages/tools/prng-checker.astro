---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UnderConstruction from '../../components/UnderConstruction.astro';

const title = 'PRNG-проверка крита — GoblinCodex';
const description =
  'Считай, сработает ли крит/бонус (Native, Tough Tree, Rock Golem, Pickaxe Shark и другие) на конкретном действии в Sunflower Land — по формуле детерминированного PRNG из кода игры.';
---

<BaseLayout title={title} description={description} currentPage="tools">
  <UnderConstruction
    title="PRNG-проверка крита"
    description="Дорабатываем инструмент — скоро вернём его в строй."
    backHref="/tools"
    backLabel="Инструменты"
  />
</BaseLayout>
