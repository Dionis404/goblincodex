---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrngChanceChecker from '../../components/tools/PrngChanceChecker.tsx';

const title = 'PRNG-проверка крита — GoblinCodex';
const description =
  'Считай, сработает ли крит/бонус (Native, Tough Tree, Rock Golem, Pickaxe Shark и другие) на конкретном действии в Sunflower Land — по формуле детерминированного PRNG из кода игры.';
---

<BaseLayout title={title} description={description} currentPage="tools">
  <main class="gc-calc-page">
    <header class="gc-calc-header">
      <span class="gc-calc-tag">Калькулятор</span>
      <h1>PRNG-проверка крита</h1>
      <p>
        Sunflower Land не использует Math.random() для критов и бонусных
        дропов на фарм-действиях — исход детерминирован и зависит от Farm ID,
        ID ресурса, счётчика действия и имени эффекта. Введи свои данные,
        чтобы посчитать, сработает ли эффект.
      </p>
    </header>

    <PrngChanceChecker client:load />
  </main>
</BaseLayout>

<style is:global>
  .gc-calc-page {
    max-width: 1160px;
    margin: 0 auto;
    padding: 32px 24px 64px;
  }

  .gc-calc-header {
    margin-bottom: 28px;
  }
  .gc-calc-header h1 {
    font-family: var(--font-head);
    font-size: 32px;
    margin: 12px 0 8px;
    color: var(--text);
  }
  .gc-calc-header p {
    color: var(--text-sec);
    line-height: 1.7;
    max-width: 640px;
  }

  .gc-calc-tag {
    display: inline-block;
    font-size: 12px;
    font-weight: 500;
    padding: 3px 10px;
    border-radius: 6px;
    background: var(--green-pale);
    color: var(--green-dark);
  }

  .gc-calc-grid {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 24px;
    align-items: start;
  }
  @media (max-width: 860px) {
    .gc-calc-grid {
      grid-template-columns: 1fr;
    }
  }

  .gc-calc-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 20px;
  }

  .gc-calc-h2 {
    font-family: var(--font-head);
    font-size: 18px;
    margin: 0 0 14px;
    color: var(--text);
  }

  .gc-calc-field {
    display: block;
    margin-top: 14px;
  }
  .gc-calc-field > span {
    display: block;
    font-size: 14px;
    color: var(--text-sec);
    margin-bottom: 4px;
  }
  .gc-calc-field small {
    display: block;
    font-size: 12px;
    color: var(--text-ter);
    margin-top: 4px;
  }
  .gc-calc-field input,
  .gc-calc-field select {
    width: 100%;
    padding: 8px 10px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
  }

  .gc-calc-fieldset {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px 14px 14px;
    margin-top: 16px;
  }
  .gc-calc-fieldset legend {
    font-size: 13px;
    color: var(--text-sec);
    padding: 0 6px;
  }
  .gc-calc-fieldset > small {
    display: block;
    font-size: 12px;
    color: var(--text-ter);
    margin-top: 10px;
    line-height: 1.5;
  }

  .gc-calc-kpis {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 18px;
  }
  .gc-calc-kpi {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px;
    text-align: center;
  }
  .gc-calc-kpi-label {
    font-size: 12px;
    color: var(--text-sec);
  }
  .gc-calc-kpi-value {
    font-family: var(--font-head);
    font-size: 22px;
    color: var(--green-dark);
    margin-top: 4px;
  }
  .gc-calc-kpi-value[data-profit='bad'] {
    color: var(--red);
  }

  .gc-calc-table-wrap {
    overflow-x: auto;
    max-height: 420px;
    overflow-y: auto;
  }
  .gc-calc-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .gc-calc-table th {
    background: var(--green-dark);
    color: var(--green-pale);
    text-align: left;
    padding: 9px 10px;
    font-weight: 500;
    white-space: nowrap;
    position: sticky;
    top: 0;
  }
  .gc-calc-table th:first-child {
    border-top-left-radius: 8px;
  }
  .gc-calc-table th:last-child {
    border-top-right-radius: 8px;
  }
  .gc-calc-table td {
    padding: 9px 10px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
  }
  .gc-calc-table tbody tr:nth-child(odd) td {
    background: var(--green-pale);
  }

  .gc-calc-badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 500;
    padding: 3px 9px;
    border-radius: 6px;
  }
  .gc-calc-badge[data-profit='good'] {
    background: var(--green-pale);
    color: var(--green-dark);
  }
  .gc-calc-badge[data-profit='bad'] {
    background: var(--amber-pale);
    color: var(--amber);
  }

  .gc-calc-note {
    font-size: 13px;
    color: var(--text-ter);
    line-height: 1.6;
    margin-top: 14px;
  }

  .gc-prng-farm-card {
    margin-bottom: 20px;
  }
  .gc-prng-farm-card small {
    display: block;
    margin-top: 8px;
    color: var(--text-ter);
    line-height: 1.5;
  }

  .gc-prng-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }
  .gc-prng-tab {
    padding: 8px 16px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--card-bg);
    color: var(--text-sec);
    font-family: var(--font-body);
    font-size: 14px;
    cursor: pointer;
    transition: all 0.15s;
  }
  .gc-prng-tab:hover {
    border-color: var(--green-mid);
  }
  .gc-prng-tab[data-active='true'] {
    background: var(--green-dark);
    color: var(--green-pale);
    border-color: var(--green-dark);
  }

  .gc-prng-mechanics {
    display: grid;
    gap: 16px;
    margin-top: 16px;
  }

  .gc-prng-mechanic-card {
    padding: 18px 20px;
  }
  .gc-prng-mechanic-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 14px;
  }
  .gc-prng-mechanic-head h3 {
    font-family: var(--font-head);
    font-size: 16px;
    margin: 0 0 4px;
    color: var(--text);
  }
  .gc-prng-mechanic-head small {
    color: var(--text-sec);
  }
</style>
