---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UnderConstruction from '../../components/UnderConstruction.astro';

const title = 'Калькулятор добычи — GoblinCodex';
const description =
  'Считай выгодность добычи дерева и руды в Sunflower Land: профит на единицу и на инструмент с учётом скиллов, курса COIN и комиссии рынка.';
---

<BaseLayout title={title} description={description} noindex={true}>
  <UnderConstruction
    title="Калькулятор выгодности добычи"
    description="Дорабатываем расчёт — скоро вернём калькулятор в строй."
    backHref="/tools"
    backLabel="Инструменты"
  />
</BaseLayout>
