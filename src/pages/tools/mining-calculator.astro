---
// Страница калькулятора добычи.
// ВАЖНО: проверь путь к лэйауту — у тебя он называется BaseLayout (см. План с нуля).
// Если файл лежит иначе, поправь импорт ниже.
import BaseLayout from '../../layouts/BaseLayout.astro';
import MiningCalculator from '../../components/tools/MiningCalculator.tsx';

const title = 'Калькулятор добычи — GoblinCodex';
const description =
  'Считай выгодность добычи дерева и руды в Sunflower Land: профит на единицу и на инструмент с учётом скиллов, курса COIN и комиссии рынка.';
---

<BaseLayout title={title} description={description}>
  <main class="gc-calc-page">
    <header class="gc-calc-header">
      <span class="gc-calc-tag">Калькулятор</span>
      <h1>Калькулятор выгодности добычи</h1>
      <p>
        Стоит ли крафтить инструмент и копать ресурс — или дешевле купить его на
        P2P-рынке. Цены подтягиваются с рынка автоматически.
      </p>
    </header>

    <!-- client:load — остров оживает сразу при загрузке страницы -->
    <MiningCalculator client:load />
  </main>
</BaseLayout>

<style is:global>
  /* Стили калькулятора. Все цвета — через токены global.css.
     В тёмной теме var(--green-*) автоматически ремапится в фиолетовый. */

  .gc-calc-page {
    max-width: 1160px;
    margin: 0 auto;
    padding: 32px 24px 64px;
  }

  .gc-calc-header {
    margin-bottom: 28px;
  }
  .gc-calc-header h1 {
    font-family: var(--font-head);
    font-size: 32px;
    margin: 12px 0 8px;
    color: var(--text);
  }
  .gc-calc-header p {
    color: var(--text-sec);
    line-height: 1.7;
    max-width: 640px;
  }

  .gc-calc-tag {
    display: inline-block;
    font-size: 12px;
    font-weight: 500;
    padding: 3px 10px;
    border-radius: 6px;
    background: var(--green-pale);
    color: var(--green-dark);
  }

  /* ── Сетка: параметры | результаты ── */
  .gc-calc-grid {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 24px;
    align-items: start;
  }
  @media (max-width: 860px) {
    .gc-calc-grid {
      grid-template-columns: 1fr;
    }
  }

  .gc-calc-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 20px;
  }

  .gc-calc-h2 {
    font-family: var(--font-head);
    font-size: 18px;
    margin: 0 0 14px;
    color: var(--text);
  }

  /* ── Статус API ── */
  .gc-calc-status {
    font-size: 13px;
    padding: 8px 12px;
    border-radius: 8px;
    margin-bottom: 10px;
    background: var(--green-pale);
    color: var(--green-dark);
  }
  .gc-calc-status[data-status='fallback'] {
    background: var(--amber-pale);
    color: var(--amber);
  }

  /* ── Поля ── */
  .gc-calc-field {
    display: block;
    margin-top: 14px;
  }
  .gc-calc-field > span {
    display: block;
    font-size: 14px;
    color: var(--text-sec);
    margin-bottom: 4px;
  }
  .gc-calc-field small {
    display: block;
    font-size: 12px;
    color: var(--text-ter);
    margin-top: 4px;
  }
  .gc-calc-field input,
  .gc-calc-field select {
    width: 100%;
    padding: 8px 10px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
  }
  .gc-calc-field-row {
    display: grid;
    grid-template-columns: 1fr 90px;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
  }
  .gc-calc-field-row > span {
    margin-bottom: 0;
  }

  .gc-calc-fieldset {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px 14px 14px;
    margin-top: 16px;
  }
  .gc-calc-fieldset legend {
    font-size: 13px;
    color: var(--text-sec);
    padding: 0 6px;
  }
  .gc-calc-check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--text);
    margin-top: 8px;
    cursor: pointer;
  }

  /* ── Кнопки (в стиле дизайн-системы) ── */
  .gc-btn {
    display: inline-block;
    padding: 9px 18px;
    border-radius: 8px;
    font-family: var(--font-body);
    font-weight: 500;
    cursor: pointer;
    border: 1px solid transparent;
  }
  .gc-btn-secondary {
    background: transparent;
    border-color: var(--border);
    color: var(--text);
    margin-top: 8px;
  }
  .gc-btn-secondary:hover {
    background: var(--green-pale);
  }

  /* ── KPI ── */
  .gc-calc-kpis {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 18px;
  }
  .gc-calc-kpi {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px;
    text-align: center;
  }
  .gc-calc-kpi-label {
    font-size: 12px;
    color: var(--text-sec);
  }
  .gc-calc-kpi-value {
    font-family: var(--font-head);
    font-size: 22px;
    color: var(--green-dark);
    margin-top: 4px;
  }

  /* ── Таблица ── */
  .gc-calc-table-wrap {
    overflow-x: auto;
  }
  .gc-calc-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .gc-calc-table th {
    background: var(--green-dark);
    color: var(--green-pale);
    text-align: left;
    padding: 9px 10px;
    font-weight: 500;
    white-space: nowrap;
  }
  .gc-calc-table th:first-child {
    border-top-left-radius: 8px;
  }
  .gc-calc-table th:last-child {
    border-top-right-radius: 8px;
  }
  .gc-calc-table td {
    padding: 9px 10px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
  }
  .gc-calc-table tbody tr:nth-child(odd) td {
    background: var(--green-pale);
  }
  /* Числа — моноширинно, как требует дизайн-система */
  .gc-calc-num {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .gc-calc-num[data-profit='good'] {
    color: var(--green-dark);
    font-weight: 500;
  }
  .gc-calc-num[data-profit='bad'] {
    color: var(--red);
    font-weight: 500;
  }

  .gc-calc-badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 500;
    padding: 3px 9px;
    border-radius: 6px;
  }
  .gc-calc-badge[data-profit='good'] {
    background: var(--green-pale);
    color: var(--green-dark);
  }
  .gc-calc-badge[data-profit='bad'] {
    background: var(--amber-pale);
    color: var(--amber);
  }

  .gc-calc-note {
    font-size: 13px;
    color: var(--text-ter);
    line-height: 1.6;
    margin-top: 14px;
  }
</style>
