---
import BaseLayout from '../../layouts/BaseLayout.astro';
import XpCalculator from '../../components/tools/XpCalculator.tsx';
import '../../styles/calculator.css';

const title = 'Калькулятор опыта — GoblinCodex';
const description =
  'Калькулятор опыта бампкина Sunflower Land: введи уровень и опыт как в игре, выбери цель — и получи самый быстрый, самый дешёвый или оптимальный план прокачки едой с учётом навыков и ежедневных VIP-блюд.';
---

<BaseLayout title={title} description={description}>
  <main class="gc-calc-page">
    <a href="/tools" class="gc-btn-secondary gc-calc-back">← Инструменты</a>

    <header class="gc-calc-header">
      <span class="gc-calc-tag">Калькулятор</span>
      <h1>Калькулятор опыта</h1>
      <p>
        Введи уровень и опыт так, как их показывает игра, выбери цель — и мы посчитаем, сколько опыта
        осталось, а затем подберём план прокачки едой: самый быстрый, самый дешёвый (во Flower) или
        оптимальный. Учитываем твои навыки и бусты, а для VIP — ещё и ежедневное блюдо за вход.
      </p>
    </header>

    <XpCalculator client:load />
  </main>
</BaseLayout>

<style is:global>
  .gc-xp-progress-bar {
    margin-top: 14px;
    height: 8px;
    border-radius: 999px;
    background: var(--bg);
    border: 1px solid var(--border);
    overflow: hidden;
  }
  .gc-xp-progress-fill {
    height: 100%;
    background: var(--green-mid);
    border-radius: 999px;
    transition: width 0.2s ease;
  }
</style>
