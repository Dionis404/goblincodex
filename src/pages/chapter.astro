---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import ChapterContent from '../components/ChapterContent.astro';
import ChapterMechanicModal from '../components/ChapterMechanicModal.astro';
import ChapterTimer from '../components/ChapterTimer.tsx';

const CURRENT_CHAPTER_NAME = 'The Ascension Age';
---

<BaseLayout
  currentPage="chapter"
  title="Ascension Age — текущая глава Sunflower Land | GoblinCodex"
  description="Гайды по механике главы Ascension Age, предметы и расписание аукционов Sunflower Land."
>
  <div class="gc-content gc-page-enter">

    <!-- Баннер текущей главы -->
    <div class="gc-codex-chapter-block">
      <a href="/chapter" class="gc-codex-chapter-banner">
        <img src="/images/chapter 15.png" alt={`${CURRENT_CHAPTER_NAME} — Chapter 15`} class="gc-codex-chapter-img gc-codex-chapter-img--light" />
        <img src="/images/chapter 15.png" alt={`${CURRENT_CHAPTER_NAME} — Chapter 15`} class="gc-codex-chapter-img gc-codex-chapter-img--dark" />
      </a>
      <div class="gc-codex-chapter-timer">
        <ChapterTimer client:load />
        <span class="gc-btn-cta gc-codex-chapter-current">Текущая глава</span>
      </div>
    </div>

    <a href="/chapter/past" class="gc-btn-secondary gc-chapter-past-link">📜 Прошлые главы</a>

    <ChapterContent />
  </div>

  <!-- Вне .gc-content, чтобы position:fixed оверлея не зависел от вложенности -->
  <ChapterMechanicModal />
</BaseLayout>

<style>
.gc-codex-chapter-block {
  position: relative;
  margin: 24px 0 40px;
}
.gc-codex-chapter-banner {
  display: block;
  width: 100%;
  line-height: 0;
  filter: drop-shadow(0 8px 24px rgba(0,0,0,0.25));
  position: relative;
  z-index: 2;
  border-radius: 14px;
  overflow: hidden;
}
:global(.gc-codex-chapter-img) {
  width: 100%;
  height: auto;
  display: block;
  image-rendering: pixelated;
}
:global(.gc-codex-chapter-img--dark) { display: none; }
:global([data-theme="dark"]) :global(.gc-codex-chapter-img--light) { display: none; }
:global([data-theme="dark"]) :global(.gc-codex-chapter-img--dark)  { display: block; }

.gc-codex-chapter-timer {
  background: #5C3D1E;
  border-radius: 14px;
  padding: 20px 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  max-width: 75%;
  margin: -20px auto 0;
  position: relative;
  z-index: 1;
  box-shadow: 0 4px 16px rgba(0,0,0,0.3);
}
.gc-codex-chapter-current {
  cursor: default;
  pointer-events: none;
  opacity: 0.85;
}
:global(.gc-timer-row) {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15px;
  flex: 1;
  padding-top: 10px;
}
:global(.gc-timer-label) {
  font-size: 15px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: rgba(255,255,255,0.5);
  text-align: center;
  font-family: 'Press Start 2P', monospace;
}
:global(.gc-timer-digits) {
  display: flex;
  align-items: baseline;
  gap: 8px;
  justify-content: center;
}
:global(.gc-timer-value) {
  font-family: 'Press Start 2P', monospace;
  font-size: 28px;
  color: #e8ece3;
  letter-spacing: 3px;
}
@media (max-width: 700px) {
  .gc-codex-chapter-timer { max-width: 100%; flex-direction: column; padding: 18px 20px; }
}

.gc-chapter-past-link {
  display: inline-flex;
  margin-bottom: 32px;
}
</style>
