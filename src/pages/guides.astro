---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout currentPage="/guides" title="База знаний — GoblinCodex">
  <div class="gc-content">
    <h1 class="gc-page-title" style="margin-top: 32px; margin-bottom: 24px;">📚 База знаний</h1>

    <div class="gc-grid-2" style="margin-bottom: 40px;">
      <div class="gc-card gc-card-hover" style="padding: 24px; cursor: pointer;">
        <div style="font-size: 24px; margin-bottom: 12px;">🌾</div>
        <h3 style="font-family: var(--font-head); font-weight: 600; margin-bottom: 8px; color: var(--text);">Выращивание урожая</h3>
        <p style="font-size: 13px; color: var(--text-sec); line-height: 1.5;">Полное руководство по посадке, выращиванию и сбору урожая различных культур.</p>
      </div>

      <div class="gc-card gc-card-hover" style="padding: 24px; cursor: pointer;">
        <div style="font-size: 24px; margin-bottom: 12px;">🐔</div>
        <h3 style="font-family: var(--font-head); font-weight: 600; margin-bottom: 8px; color: var(--text);">Разведение животных</h3>
        <p style="font-size: 13px; color: var(--text-sec); line-height: 1.5;">Всё о домашних животных: как их получить, кормить и получить продукты.</p>
      </div>

      <div class="gc-card gc-card-hover" style="padding: 24px; cursor: pointer;">
        <div style="font-size: 24px; margin-bottom: 12px;">💰</div>
        <h3 style="font-family: var(--font-head); font-weight: 600; margin-bottom: 8px; color: var(--text);">Экономика фермы</h3>
        <p style="font-size: 13px; color: var(--text-sec); line-height: 1.5;">Советы по заработку, инвестициям и развитию финансов вашей фермы.</p>
      </div>

      <div class="gc-card gc-card-hover" style="padding: 24px; cursor: pointer;">
        <div style="font-size: 24px; margin-bottom: 12px;">🏗️</div>
        <h3 style="font-family: var(--font-head); font-weight: 600; margin-bottom: 8px; color: var(--text);">Постройки и улучшения</h3>
        <p style="font-size: 13px; color: var(--text-sec); line-height: 1.5;">Как строить, улучшать и оптимизировать постройки на ферме.</p>
      </div>

      <div class="gc-card gc-card-hover" style="padding: 24px; cursor: pointer;">
        <div style="font-size: 24px; margin-bottom: 12px;">✨</div>
        <h3 style="font-family: var(--font-head); font-weight: 600; margin-bottom: 8px; color: var(--text);">Крафт и рецепты</h3>
        <p style="font-size: 13px; color: var(--text-sec); line-height: 1.5;">Все рецепты крафта, алхимии и создания предметов в игре.</p>
      </div>

      <div class="gc-card gc-card-hover" style="padding: 24px; cursor: pointer;">
        <div style="font-size: 24px; margin-bottom: 12px;">🎮</div>
        <h3 style="font-family: var(--font-head); font-weight: 600; margin-bottom: 8px; color: var(--text);">Советы и трюки</h3>
        <p style="font-size: 13px; color: var(--text-sec); line-height: 1.5;">Полезные советы, трюки и оптимизация для опытных и новых игроков.</p>
      </div>
    </div>
  </div>
</BaseLayout>
