---
import BaseLayout from '../layouts/BaseLayout.astro';

const costs = [
  {
    icon: '🖥️',
    title: 'Сервер',
    value: '1 000 ₽/мес',
    desc: 'Хостинг сайта, базы данных NFT-каталога и бэкенда',
  },
  {
    icon: '🤖',
    title: 'AI для ботов',
    value: 'от $3/мес',
    desc: 'Оплата API нейросетей для Telegram-ботов сообщества — сумма растёт при масштабировании',
  },
  {
    icon: '🌐',
    title: 'Домены',
    value: '5 000 ₽/год',
    desc: '2 домена проекта (≈ 417 ₽/мес)',
  },
];
---

<BaseLayout
  currentPage="donate"
  title="Поддержать проект — GoblinCodex"
  description="Поддержи GoblinCodex донатом: на что уходят средства — сервер, боты сообщества и домены."
>
  <div class="gc-donate-wrap gc-page-enter">

    <!-- ── Заголовок ── -->
    <div class="gc-donate-header">
      <h1 class="gc-page-title">❤️ Поддержать проект</h1>
      <p class="gc-donate-sub">Помоги гоблинам содержать сайт и ботов для сообщества</p>
    </div>

    <!-- ── О донатах ── -->
    <div class="gc-donate-intro gc-card">
      <h2 class="gc-intro-title">Зачем это нужно 👋</h2>
      <p class="gc-intro-text">
        GoblinCodex — некоммерческий фан-проект. Донаты не идут никому в карман — они полностью
        покрывают расходы на сервер, домены и Telegram-ботов, которыми пользуется сообщество.
      </p>
    </div>

    <!-- ── На что уходят донаты ── -->
    <div class="gc-donate-costs-section">
      <h2 class="gc-roadmap-h2">💸 На что уходят донаты</h2>
      <p class="gc-roadmap-sub">Прозрачная разбивка ежемесячных расходов проекта</p>

      <div class="gc-grid-3">
        {costs.map(c => (
          <div class="gc-card gc-cost-card">
            <div class="gc-cost-icon">{c.icon}</div>
            <div class="gc-cost-title">{c.title}</div>
            <div class="gc-cost-value">{c.value}</div>
            <div class="gc-cost-desc">{c.desc}</div>
          </div>
        ))}
      </div>

      <p class="gc-donate-total">
        Итого: около <strong>1 400 ₽/мес</strong> на сервер и домены + <strong>от $3/мес</strong> на AI для ботов —
        и эта сумма растёт вместе с сообществом.
      </p>
    </div>

    <!-- ── Способы поддержать ── -->
    <div class="gc-donate-methods-section">
      <h2 class="gc-roadmap-h2">💳 Как поддержать</h2>
      <p class="gc-roadmap-sub">Любая сумма помогает — спасибо!</p>

      <div class="gc-donate-methods">
        <div class="gc-card gc-method-card">
          <div class="gc-method-title">💳 Донат картой</div>
          <div class="gc-method-value">
            <a href="https://pay.cloudtips.ru/p/1d436e37" target="_blank" rel="noopener noreferrer">
              https://pay.cloudtips.ru/p/1d436e37
            </a>
          </div>
          <button class="gc-btn-secondary gc-method-copy" data-copy="https://pay.cloudtips.ru/p/1d436e37">
            Скопировать ссылку
          </button>
        </div>

        <div class="gc-card gc-method-card">
          <div class="gc-method-title">💎 Крипто</div>
          <div class="gc-method-value gc-method-value--mono">
            0xf292959d216CB539Dc84E8F6cb9f11F55D877E32
          </div>
          <button class="gc-btn-secondary gc-method-copy" data-copy="0xf292959d216CB539Dc84E8F6cb9f11F55D877E32">
            Скопировать адрес
          </button>
          <div class="gc-method-note">Сети: Base / ETH / Polygon</div>
        </div>
      </div>
    </div>

    <!-- ── CTA ── -->
    <div class="gc-cta-banner">
      <div>
        <div class="gc-cta-title">🙏 Спасибо за поддержку!</div>
        <div class="gc-cta-desc">Ты помогаешь гоблинам работать быстрее и держать сайт и ботов на плаву</div>
      </div>
      <div class="gc-about-cta-btns">
        <a href="https://t.me/URGSFL" target="_blank" rel="noopener" class="gc-btn-cta">Написать в чат</a>
        <a href="/about" class="gc-btn-cta">О проекте</a>
      </div>
    </div>

  </div>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.gc-method-copy').forEach(btn => {
    const originalLabel = btn.textContent ?? '';
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const textarea = document.createElement('textarea');
        textarea.value = text;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
      }
      btn.textContent = '✓ Скопировано';
      setTimeout(() => { btn.textContent = originalLabel; }, 1500);
    });
  });
</script>

<style>
.gc-donate-wrap {
  max-width: 1160px;
  margin: 0 auto;
  padding: 48px 40px 64px;
  display: flex;
  flex-direction: column;
  gap: 32px;
}

.gc-donate-header { text-align: center; }
.gc-donate-sub {
  font-size: 15px;
  color: var(--text-sec);
}

.gc-donate-intro {
  padding: 32px 36px;
  border-left: 4px solid var(--amber);
}
.gc-intro-title {
  font-family: var(--font-head);
  font-size: 20px;
  font-weight: 700;
  color: var(--green-dark);
  margin-bottom: 16px;
}
.gc-intro-text {
  font-size: 15px;
  line-height: 1.7;
  color: var(--text);
}

/* ── Расходы ── */
.gc-donate-costs-section { display: flex; flex-direction: column; gap: 8px; }
.gc-cost-card {
  padding: 24px 22px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
}
.gc-cost-icon { font-size: 28px; margin-bottom: 4px; }
.gc-cost-title { font-size: 13px; font-weight: 600; color: var(--text-sec); }
.gc-cost-value {
  font-family: var(--font-head);
  font-size: 20px;
  font-weight: 700;
  color: var(--green-dark);
}
.gc-cost-desc { font-size: 12px; color: var(--text-sec); line-height: 1.5; }

.gc-donate-total {
  margin-top: 16px;
  font-size: 14px;
  color: var(--text-sec);
  text-align: center;
  line-height: 1.6;
}
.gc-donate-total strong { color: var(--text); }

/* ── Способы поддержать ── */
.gc-donate-methods-section { display: flex; flex-direction: column; gap: 8px; }
.gc-donate-methods {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.gc-method-card { padding: 22px 26px; }
.gc-method-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 12px;
}
.gc-method-value {
  font-size: 13px;
  word-break: break-all;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 10px 14px;
  margin-bottom: 12px;
  line-height: 1.6;
  color: var(--text);
}
.gc-method-value--mono { font-family: 'Courier New', monospace; user-select: all; }
.gc-method-value a {
  color: var(--green-dark);
  text-decoration: none;
  font-weight: 600;
}
.gc-method-value a:hover { text-decoration: underline; }
.gc-method-copy { min-width: 180px; }
.gc-method-note {
  font-size: 12px;
  color: var(--text-sec);
  margin-top: 10px;
  font-style: italic;
}

/* ── Roadmap heading reuse ── */
.gc-roadmap-h2 {
  font-family: var(--font-head);
  font-size: 24px;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 4px;
}
.gc-roadmap-sub {
  font-size: 14px;
  color: var(--text-sec);
  margin-bottom: 16px;
}

.gc-about-cta-btns {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

/* ── Адаптив ── */
@media (max-width: 700px) {
  .gc-donate-wrap { padding: 32px 20px 48px; gap: 24px; }
  .gc-donate-intro { padding: 20px 20px; }
  .gc-method-card { padding: 18px 20px; }
  .gc-about-cta-btns { flex-direction: column; }
}
</style>
