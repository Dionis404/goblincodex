---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { CHAPTERS, getPastChapters } from '../../../lib/chapters';

const pastChapters = getPastChapters().sort((a, b) => b.order - a.order);

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
}
---

<BaseLayout
  currentPage="codex"
  title="Прошлые главы Sunflower Land | GoblinCodex"
  description="Архив прошлых глав Sunflower Land — даты, тикеты и аукционы каждой главы."
>
  <div class="gc-content gc-page-enter">

    <a href="/codex?tab=chapter" class="gc-btn-secondary gc-past-back">← Текущая глава</a>

    <div class="gc-past-header">
      <h1 class="gc-page-title">📜 Прошлые главы</h1>
      <p class="gc-past-sub">Архив прошлых глав Sunflower Land — {pastChapters.length} из {CHAPTERS.length}</p>
    </div>

    {pastChapters.length === 0 ? (
      <div class="gc-past-empty">
        <div class="gc-past-empty-icon">🚧</div>
        <div class="gc-past-empty-title">Скоро здесь появится история</div>
        <p class="gc-past-empty-desc">
          Список прошлых глав ещё собирается — загляните позже.
        </p>
      </div>
    ) : (
      <div class="gc-chapters-grid">
        {pastChapters.map(ch => (
          <a href={`/codex/chapter/${ch.slug}`} class="gc-card gc-card-hover gc-chapter-card">
            <div class="gc-chapter-card-top">
              <span class="gc-chapter-card-order">Глава {ch.order}</span>
              <span class="gc-chapter-card-artifact">🏺 {ch.artifact}</span>
            </div>
            <div class="gc-chapter-card-name">{ch.name}</div>
            <div class="gc-chapter-card-dates">{formatDate(ch.startDate)} — {formatDate(ch.endDate)}</div>
          </a>
        ))}
      </div>
    )}

  </div>
</BaseLayout>

<style>
.gc-past-back {
  display: inline-flex;
  margin: 20px 0 0;
}
.gc-past-header { padding: 24px 0; }
.gc-past-sub { font-size: 15px; color: var(--text-sec); margin-top: 6px; }

.gc-past-empty {
  padding: 64px 32px;
  text-align: center;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 14px;
  margin-bottom: 48px;
}
.gc-past-empty-icon { font-size: 32px; margin-bottom: 12px; }
.gc-past-empty-title {
  font-family: var(--font-head);
  font-size: 16px;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 8px;
}
.gc-past-empty-desc {
  font-size: 13.5px;
  color: var(--text-sec);
  max-width: 420px;
  margin: 0 auto;
  line-height: 1.6;
}

.gc-chapters-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 16px;
  margin-bottom: 48px;
}
.gc-chapter-card {
  display: block;
  padding: 18px 20px;
  text-decoration: none;
  color: var(--text);
}
.gc-chapter-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 10px;
}
.gc-chapter-card-order {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--green-dark);
}
.gc-chapter-card-artifact { font-size: 12px; color: var(--text-sec); }
.gc-chapter-card-name {
  font-family: var(--font-head);
  font-size: 16px;
  font-weight: 700;
  margin-bottom: 6px;
}
.gc-chapter-card-dates { font-size: 12.5px; color: var(--text-sec); }

@media (max-width: 640px) {
  .gc-chapters-grid { grid-template-columns: 1fr; }
}
</style>
