---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render, getCollection } from 'astro:content';
import GuideAuthorBlock from '../../components/GuideAuthorBlock.tsx';

const { id } = Astro.params;
const guide = await getEntry('guides', id!);

if (!guide || guide.data.draft) {
  return Astro.redirect('/codex', 302);
}

const { Content, headings } = await render(guide);

const tagColors: Record<string, string> = {
  'Новичкам':   'green',
  'Экономика':  'amber',
  'Фермерство': 'green',
  'Крафт':      'purple',
  'Основы':     'blue',
  'Лайфхаки':     'amber',
  'NPC':        'purple',
  'Достижения': 'blue',
  'Предметы':   'green',
};

const tagColor = tagColors[guide.data.category] ?? 'green';

// Build guidesByUser for author + contributors of this guide (for the modal)
const relevantUsers = [guide.data.author, ...(guide.data.contributors ?? [])]
  .filter(Boolean)
  .map((u) => u!.toLowerCase());

const guidesByUser: Record<string, { authored: any[]; contributed: any[] }> = {};
for (const u of relevantUsers) guidesByUser[u] = { authored: [], contributed: [] };

if (relevantUsers.length > 0) {
  for (const g of await getCollection('guides')) {
    if (g.data.draft) continue;
    const info = { id: g.id, title: g.data.title, icon: g.data.icon };
    if (g.data.author && relevantUsers.includes(g.data.author.toLowerCase()))
      guidesByUser[g.data.author.toLowerCase()].authored.push(info);
    for (const n of g.data.contributors ?? [])
      if (relevantUsers.includes(n.toLowerCase()))
        guidesByUser[n.toLowerCase()].contributed.push(info);
  }
}
---

<BaseLayout
  currentPage="codex"
  title={`${guide.data.title} — GoblinCodex`}
  description={guide.data.description}
  type="article"
>
  <div class="gc-content gc-page-enter">

    <!-- Кнопка назад (сверху) -->
    <a href="/codex" class="gc-btn-secondary gc-guide-back-top">← Назад к гайдам</a>

    <!-- Основной двухколоночный layout -->
    <div class="gc-guide-layout">

      <!-- Левая колонка: весь контент -->
      <div class="gc-guide-main">

        <!-- Хлебные крошки -->
        <nav class="gc-breadcrumb">
          <a href="/codex">Кодекс</a>
          <span>›</span>
          <a href="/codex">Гайды</a>
          <span>›</span>
          <span>{guide.data.title}</span>
        </nav>

        <!-- Мета -->
        <div class="gc-guide-page-meta">
          <span class={`gc-tag gc-tag--${tagColor}`}>{guide.data.category}</span>
          <span class="gc-guide-page-time">⏱ {guide.data.readTime} мин чтения</span>
          {guide.data.publishDate && (
            <span class="gc-guide-page-date">
              📅 {new Date(guide.data.publishDate).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })}
            </span>
          )}
          {guide.data.updatedDate && (
            <span class="gc-guide-page-date">
              ✏️ {new Date(guide.data.updatedDate).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })}
            </span>
          )}
        </div>

        <!-- Заголовок -->
        <h1 class="gc-guide-page-title">
          {guide.data.icon} {guide.data.title}
        </h1>

        <!-- Автор и контрибьюторы — открывают модальную карточку профиля -->
        {(guide.data.author || (guide.data.contributors?.length ?? 0) > 0) && (
          <GuideAuthorBlock
            client:load
            author={guide.data.author}
            contributors={guide.data.contributors}
            guidesByUser={guidesByUser}
          />
        )}

        <hr class="gc-guide-divider" />

        <!-- Контент -->
        <article class="gc-guide-article">
          <Content />
        </article>

      </div>

      <!-- Правая колонка: оглавление -->
      {headings.length > 0 && (
        <aside class="gc-guide-toc">
          <div class="gc-guide-toc-inner" id="tocPanel">
            <div class="gc-guide-toc-title">Содержание</div>
            <nav>
              {headings.map(h => (
                <a
                  href={`#${h.slug}`}
                  class={`gc-toc-link gc-toc-link--h${h.depth}`}
                >
                  {h.text}
                </a>
              ))}
            </nav>
          </div>
        </aside>
      )}

    </div>

  </div>
</BaseLayout>

<style>
/* ── Хлебные крошки ── */
.gc-breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: var(--text-sec);
  padding: 24px 0 16px;
}
.gc-breadcrumb a {
  color: var(--green-dark);
  text-decoration: none;
}
.gc-breadcrumb a:hover { text-decoration: underline; }

/* ── Мета ── */
.gc-guide-page-meta {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 12px;
}
.gc-guide-page-time,
.gc-guide-page-date {
  font-size: 13px;
  color: var(--text-sec);
}

/* ── Заголовок ── */
.gc-guide-page-title {
  font-family: var(--font-head);
  font-size: 32px;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -0.02em;
  color: var(--text);
  margin-bottom: 16px;
}

/* ── Кнопка назад (сверху) ── */
.gc-guide-back-top {
  display: inline-flex;
  margin: 20px 0 16px;
}

/* ── Layout ── */
.gc-guide-layout {
  display: grid;
  grid-template-columns: 1fr 240px;
  gap: 40px;
  align-items: start;
  margin-bottom: 40px;
}
.gc-guide-main { min-width: 0; }

/* ── Контент статьи: базовый вид .gc-guide-article в src/styles/global.css ── */

/* ── Разделитель ── */
.gc-guide-divider {
  border: none;
  border-top: 1px solid var(--border);
  margin: 20px 0 24px;
}

/* ── Оглавление ── */
.gc-guide-toc { position: sticky; top: 20px; }
.gc-guide-toc-inner {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 20px;
  box-shadow: var(--shadow);
}
.gc-guide-toc-title {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-ter);
  margin-bottom: 12px;
}
.gc-toc-link {
  display: block;
  font-size: 13px;
  color: var(--text-sec);
  text-decoration: none;
  padding: 5px 0;
  border-left: 2px solid transparent;
  padding-left: 10px;
  transition: all 0.15s;
  line-height: 1.4;
}
.gc-toc-link--h3 { padding-left: 20px; font-size: 12px; }
.gc-toc-link:hover {
  color: var(--green-dark);
  border-left-color: var(--green-mid);
}
.gc-toc-link.active {
  color: var(--green-dark);
  border-left-color: var(--green-dark);
  font-weight: 600;
}


/* ── Responsive ── */
@media (max-width: 900px) {
  .gc-guide-layout { grid-template-columns: 1fr !important; }
  .gc-guide-toc { display: none; }
  .gc-guide-page-title { font-size: 24px; }
}
</style>

<script>
  // Подсветка активного пункта оглавления при скролле
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.gc-toc-link');
  const headings = document.querySelectorAll<HTMLElement>('h2, h3');

  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        tocLinks.forEach(link => {
          link.classList.toggle('active', link.getAttribute('href') === `#${id}`);
        });
      }
    });
  }, { rootMargin: '-20% 0px -70% 0px' });

  headings.forEach(h => observer.observe(h));
</script>