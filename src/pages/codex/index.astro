---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import BoostsCatalog from '../../components/BoostsCatalog.tsx';
import BudsCatalog from '../../components/BudsCatalog.tsx';
import PetsCatalog from '../../components/PetsCatalog.tsx';
import ReferenceCatalog from '../../components/ReferenceCatalog.tsx';
import CommunityPage from '../../components/CommunityPage.jsx';
import ChapterContent from '../../components/ChapterContent.astro';
import ChapterMechanicModal from '../../components/ChapterMechanicModal.astro';
import ChapterTimer from '../../components/ChapterTimer.tsx';
import FishAgingTable from '../../components/tools/FishAgingTable.tsx';
import SearchWidget from '../../components/SearchWidget.tsx';
import type { getCatalogItems, getBudTraits, getBudFilterOptions, getPetNftBreeds, getPetNftTraits, getPetNftFilterOptions, getPetsCommon, getPetResources, getPetFetches } from '../../lib/db';
import {
  getCachedCatalogItems,
  getCachedBuds,
  getCachedPetsNft,
  getCachedPetsCommon,
  getCachedPetMechanics,
} from '../../lib/catalog-cache';
import { fetchWithTimeout } from '../../lib/goblinApi';

let catalogItems: Awaited<ReturnType<typeof getCatalogItems>> = [];
let budTraits: Awaited<ReturnType<typeof getBudTraits>> = [];
let budFilterOptions: Awaited<ReturnType<typeof getBudFilterOptions>> = { types: [], colours: [], stems: [], auras: [], ears: [] };
let petNftBreeds: Awaited<ReturnType<typeof getPetNftBreeds>> = [];
let petNftTraits: Awaited<ReturnType<typeof getPetNftTraits>> = [];
let petNftFilterOptions: Awaited<ReturnType<typeof getPetNftFilterOptions>> = { types: [], furs: [], accessories: [], bibs: [], auras: [] };
let petsCommon: Awaited<ReturnType<typeof getPetsCommon>> = [];
let petResources: Awaited<ReturnType<typeof getPetResources>> = [];
let petFetches: Awaited<ReturnType<typeof getPetFetches>> = [];

// Пять независимых источников (каталог, буды, NFT-питомцы, обычные питомцы,
// механики питомцев) — грузим параллельно вместо последовательных await,
// иначе время ответа страницы складывается из времени ВСЕХ запросов подряд.
const [catalogResult, budsResult, petsNftResult, petsCommonResult, petMechanicsResult] = await Promise.allSettled([
  getCachedCatalogItems(),
  getCachedBuds(),
  getCachedPetsNft(),
  getCachedPetsCommon(),
  getCachedPetMechanics(),
]);

if (catalogResult.status === 'fulfilled') {
  catalogItems = catalogResult.value.data;
} else {
  console.error('[codex] DB fetch error:', catalogResult.reason);
}

if (budsResult.status === 'fulfilled') {
  budTraits = budsResult.value.data.traits;
  budFilterOptions = budsResult.value.data.filterOptions;
} else {
  console.error('[codex] Bud fetch error:', budsResult.reason);
}

if (petsNftResult.status === 'fulfilled') {
  petNftBreeds = petsNftResult.value.data.breeds;
  petNftTraits = petsNftResult.value.data.traits;
  petNftFilterOptions = petsNftResult.value.data.filterOptions;
} else {
  console.error('[codex] Pet NFT fetch error:', petsNftResult.reason);
}

if (petsCommonResult.status === 'fulfilled') {
  petsCommon = petsCommonResult.value.data;
} else {
  console.error('[codex] Common pets fetch error:', petsCommonResult.reason);
}

if (petMechanicsResult.status === 'fulfilled') {
  petResources = petMechanicsResult.value.data.resources;
  petFetches = petMechanicsResult.value.data.fetches;
} else {
  console.error('[codex] Pet mechanics fetch error:', petMechanicsResult.reason);
}

const allGuides = await getCollection('guides', ({ data }) => !data.draft);
allGuides.sort((a, b) => new Date(b.data.publishDate ?? '').getTime() - new Date(a.data.publishDate ?? '').getTime());

// Фермеры сообщества + карта автор/контрибьютор → его гайды — раньше жило
// на отдельной странице /community (удалена, перенесено во вкладку
// "Рейтинги" вместе с лидербордами тикетов/ликвидности).
let communityFarmers: any[] = [];
let communityApiError = false;
try {
  const res = await fetchWithTimeout('http://goblin-api:8000/community/farmers');
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  communityFarmers = await res.json();
} catch (e) {
  communityApiError = true;
  console.error('[codex] Community farmers fetch error:', e);
}

const guidesByUser: Record<string, { authored: any[]; contributed: any[] }> = {};
for (const guide of allGuides) {
  const { author, contributors, title, icon } = guide.data;
  const info = { id: guide.id, title, icon };
  if (author) {
    const k = author.toLowerCase();
    guidesByUser[k] ??= { authored: [], contributed: [] };
    guidesByUser[k].authored.push(info);
  }
  for (const name of contributors ?? []) {
    const k = name.toLowerCase();
    guidesByUser[k] ??= { authored: [], contributed: [] };
    guidesByUser[k].contributed.push(info);
  }
}

const allMechanics = await getCollection('mechanics', ({ data }) => !data.draft);
allMechanics.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const mechanicsRendered = await Promise.all(
  allMechanics.map(async (m) => {
    const { Content } = await render(m);
    return { entry: m, Content };
  })
);

// "Справочник" (числовые таблицы) объединён с "Механики" в одну вкладку —
// статьи-разборы (аукционы, доставки, рафлы и т.п.) переехали в Гайды,
// здесь остались только числовые таблицы/формулы (навыки, расширения,
// соление рыбы, апгрейд нод и т.д.) — раньше "Механики" и "Справочник"
// было не отличить по названию, теперь это одна понятная вкладка.

// Подписи для 8 табличных пунктов общего сайдбара механик — держим в
// синхроне вручную с REF_SECTIONS в ReferenceCatalog.tsx (там же сами
// компоненты таблиц; здесь нужны только id/icon/label для сайдбара).
const REF_TABLE_SECTIONS = [
  { id: 'skills',     icon: '🎓', label: 'Навыки' },
  { id: 'expansions', icon: '🌋', label: 'Стоимость расширений' },
  { id: 'levels',     icon: '⭐', label: 'Опыт и Возвышение' },
  { id: 'bait',       icon: '🎣', label: 'Улов по наживке' },
  { id: 'upgrades',   icon: '⛏️', label: 'Улучшение ресурсных нод' },
  { id: 'obsidian',   icon: '🌋', label: 'Обсидиан (Lava Pit)' },
  { id: 'marvels',    icon: '🐋', label: 'Морские марвелы' },
  { id: 'food',       icon: '🍳', label: 'Еда и готовка' },
];

// Порядок и подписи вкладок: id остаются прежними (используются в URL
// ?tab=... и в JS-логике переключения), меняются только label — "Механики"
// → "Справочник" (данные/формулы), "Сообщество" → "Рейтинги" (соц. таблицы).
const sections = [
  { id: 'guides',    label: 'Гайды',        icon: '📗', sub: 'Как играть'       },
  { id: 'mechanics', label: 'Справочник',   icon: '⚙️', sub: 'Механики и рецепты' },
  { id: 'chapter',   label: 'Главы',         icon: '🗓️', sub: 'Текущая и прошлые' },
  { id: 'community', label: 'Рейтинги',     icon: '👥', sub: 'Фермеры и таблицы' },
  { id: 'nft',       label: 'NFT Предметы',  icon: '💎', sub: 'Предметы, бады, питомцы' },
];

// Точные цвета категорий из дизайн-системы — см. gc-cat-tag--* в <style>
// ниже. Не путать с общими .gc-tag--blue/green/amber/purple, которые
// используются на /news для совсем других тегов (GitHub/Стримы/Бродкаст).
const categoryTagClass: Record<string, string> = {
  'Основы':     'gc-cat-tag--osnovy',
  'Механики':   'gc-cat-tag--mehaniki',
  'Экономика':  'gc-cat-tag--ekonomika',
  'Фермерство': 'gc-cat-tag--fermerstvo',
  'Лайфхаки':   'gc-cat-tag--layfhaki',
};

const CURRENT_CHAPTER_NAME = 'The Ascension Age';

const shortAddr = (addr: string) => `${addr.slice(0, 6)}…${addr.slice(-4)}`;

let ticketsTop5: Array<{ farm_id: number; game_username?: string; tickets: number }> = [];
let ticketsUpdatedAt: string | null = null;
try {
  const res = await fetchWithTimeout('http://goblin-api:8000/api/tickets/top500');
  if (res.ok) {
    const json = await res.json();
    ticketsTop5 = (json.leaderboard ?? []).slice(0, 5);
    ticketsUpdatedAt = json.updated_at ?? null;
  }
} catch (err) {
  console.error('[codex] Tickets top-5 fetch error:', err);
}

let lpTop5: Array<{ owner: string; value_usd: number }> = [];
let lpUpdatedAt: string | null = null;
try {
  const res = await fetchWithTimeout('http://goblin-api:8000/lp/leaderboard');
  if (res.ok) {
    const json = await res.json();
    lpTop5 = (json.leaderboard ?? []).slice(0, 5);
    lpUpdatedAt = json.meta?.updated_at ?? null;
  }
} catch (err) {
  console.error('[codex] LP top-5 fetch error:', err);
}

// "5 минут назад" / "2 часа назад" / "3 дня назад" — простое относительное
// время без внешних зависимостей, достаточно грубой точности для подписи
// под лидербордом (не нужна секундная точность).
function formatUpdatedAgo(iso: string | null): string | null {
  if (!iso) return null;
  const diffMs = Date.now() - new Date(iso).getTime();
  if (diffMs < 0 || Number.isNaN(diffMs)) return null;
  const minutes = Math.floor(diffMs / 60_000);
  if (minutes < 1) return 'обновлено только что';
  if (minutes < 60) return `обновлено ${minutes} мин назад`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return `обновлено ${hours} ч назад`;
  const days = Math.floor(hours / 24);
  return `обновлено ${days} дн назад`;
}
---

<BaseLayout
  currentPage="codex"
  title="Гайды по Sunflower Land — GoblinCodex"
  description="Актуальные гайды для новичков и продвинутых игроков: механики, ресурсы, животные, рыбалка."
>
  <div class="gc-content gc-page-enter">

    <!-- Баннер текущей главы -->
    <div class="gc-codex-chapter-block">
      <a href="/codex?tab=chapter" class="gc-codex-chapter-banner">
        <img src="/images/chapter 15.png" alt={`${CURRENT_CHAPTER_NAME} — Chapter 15`} class="gc-codex-chapter-img gc-codex-chapter-img--light" />
        <img src="/images/chapter 15.png" alt={`${CURRENT_CHAPTER_NAME} — Chapter 15`} class="gc-codex-chapter-img gc-codex-chapter-img--dark" />
      </a>
      <div class="gc-codex-chapter-timer">
        <ChapterTimer client:load />
      </div>
    </div>

    <!-- Заголовок + поиск + вкладки-плитки — единый блок навигации по кодексу -->
    <div class="gc-codex-nav-block">
      <div class="gc-guides-header">
        <h1 class="gc-page-title">📚 Кодекс</h1>
        <p class="gc-codex-nav-tagline">Справочник по Sunflower Land</p>
      </div>

      <SearchWidget client:load />

      <!-- Вкладки секций: квадратные плитки-иконки. На мобильном — горизонтальная
           snap-карусель (см. media query ниже), на десктопе — обычная сетка. -->
      <div class="gc-section-tabs" id="sectionTabs">
        {sections.map((sec, i) => (
          <a
            href={`/codex?tab=${sec.id}`}
            class={`gc-section-tab${i === 0 ? ' active' : ''}`}
            data-section={sec.id}
          >
            <span class="gc-section-tab-icon">{sec.icon}</span>
            <span class="gc-section-tab-text">
              <span class="gc-section-tab-label">{sec.label}</span>
              <span class="gc-section-tab-sub">{sec.sub}</span>
            </span>
          </a>
        ))}
      </div>

      <!-- Точки-индикаторы позиции карусели — только на мобильном, чисто
           визуальные (не кликабельны), см. .gc-section-tabs-dots ниже -->
      <div class="gc-section-tabs-dots" id="sectionTabsDots">
        {sections.map((_, i) => (
          <span class={`gc-section-tabs-dot${i === 0 ? ' active' : ''}`}></span>
        ))}
      </div>
    </div>

    <!-- Фильтр категорий (только для гайдов) -->
    <div class="gc-tag-filter" id="categoryFilter">
      <button class="gc-tag-btn active" data-cat="all">⚡ Все</button>
    </div>

    <!-- Счётчик (только для гайдов) -->
    <div class="gc-guides-count" id="guidesCount"></div>

    <!-- Сетка гайдов -->
    <div class="gc-guides-grid" id="guidesGrid">
      {allGuides.map(guide => (
        <a
          href={`/codex/${guide.id}`}
          class="gc-card gc-card-hover gc-guide-card"
          data-section={guide.data.section ?? 'guides'}
          data-category={guide.data.category}
          data-title={guide.data.title.toLowerCase()}
        >
          <div class="gc-guide-card-top">
            <div class="gc-guide-card-icon">{guide.data.icon}</div>
            <div class="gc-guide-card-info">
              <div class="gc-guide-card-title">{guide.data.title}</div>
              <div class="gc-guide-card-meta">
                <span class={`gc-tag ${categoryTagClass[guide.data.category] ?? 'gc-tag--green'}`}>
                  {guide.data.category}
                </span>
                <span class="gc-guide-card-time">⏱ {guide.data.readTime} мин</span>
              </div>
            </div>
          </div>
          <div class="gc-guide-card-desc">{guide.data.description}</div>
        </a>
      ))}
    </div>

    <div class="gc-guides-no-results" id="noResults" style="display:none;">
      Ничего не найдено. Попробуй другой запрос или категорию.
    </div>

    <div class="gc-guides-empty" id="emptySection" style="display:none;">
      В этом разделе пока нет материалов. Скоро появятся!
    </div>

    <!-- ═══════════════════════════════════════════════
         МЕХАНИКИ: один общий сайдбар на 10 пунктов — 8 табличных секций
         (рендерятся React-компонентом ReferenceCatalog) + 2 markdown-статьи
         с формулами (Соление рыбы, Улучшение нод), которым формат таблицы
         не подходит. Сайдбар — чистый Astro/JS (см. .gc-ref-nav-item ниже),
         переключение табличных пунктов долетает до ReferenceCatalog через
         CustomEvent 'gc:ref-select' (см. его исходник).
         ═══════════════════════════════════════════════ -->
    <div id="mechanicsPanel" class="gc-ref-layout" style="display:none">
      <aside class="ref-sidebar gc-ref-sidebar">
        {REF_TABLE_SECTIONS.map((s, i) => (
          <a
            href={`/codex?tab=mechanics&ref=${s.id}`}
            class={`ref-nav-item gc-ref-nav-item${i === 0 ? ' active' : ''}`}
            data-ref-kind="table"
            data-ref-id={s.id}
          >
            <span class="ref-nav-icon">{s.icon}</span>
            <span class="ref-nav-label">{s.label}</span>
          </a>
        ))}
        {mechanicsRendered.map((m) => (
          <a
            href={`/codex?tab=mechanics&mech=${m.entry.id}`}
            class="ref-nav-item gc-ref-nav-item"
            data-ref-kind="article"
            data-ref-id={m.entry.id}
          >
            <span class="ref-nav-icon">{m.entry.data.icon}</span>
            <span class="ref-nav-label">{m.entry.data.title}</span>
          </a>
        ))}
      </aside>

      <div class="gc-ref-content-wrap">
        <div class="gc-boosts-hint">
          <span class="gc-boosts-hint-icon">🚧</span>
          <span><strong>Раздел в разработке:</strong> таблиц пока немного, но список будет пополняться.</span>
        </div>

        <div id="gc-ref-tables-wrap">
          <ReferenceCatalog client:visible initialRef={Astro.url.searchParams.get('ref')} />
        </div>

        {mechanicsRendered.map((m) => {
          const MechContent = m.Content;
          return (
            <article id={`mech-article-${m.entry.id}`} class="gc-guide-article gc-mech-standalone-article" style="display:none">
              <MechContent />
              {m.entry.id === 'fish-aging' && <FishAgingTable client:visible />}
            </article>
          );
        })}
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════
         NFT КАТАЛОГ
         ═══════════════════════════════════════════════ -->
    <div id="nftPanel" style="display:none">

      <div class="gc-nft-topbar">
        <div class="gc-nft-subtabs" id="nftSubtabs">
          <button type="button" class="gc-nft-subtab active" data-nft-sub="items">Предметы</button>
          <button type="button" class="gc-nft-subtab" data-nft-sub="buds">Бады</button>
          <button type="button" class="gc-nft-subtab" data-nft-sub="pets">Питомцы</button>
        </div>
        <div class="gc-lang-toggle" id="langToggle" role="group" aria-label="Язык названий бонусов">
          <button type="button" class="gc-lang-btn active" data-lang="ru">RU</button>
          <button type="button" class="gc-lang-btn" data-lang="en">EN</button>
        </div>
      </div>

      <div id="nftSubItems">
        <div class="gc-boosts-hint">
          <span class="gc-boosts-hint-icon">💡</span>
          <span><strong>Как пользоваться:</strong> выбери тип ресурса → смотри какие NFT-предметы дают бонус к нему. Клик по карточке — подробности.</span>
        </div>
        <BoostsCatalog client:load items={catalogItems} />
      </div>

      <div id="nftSubBuds" style="display:none">
        <BudsCatalog client:visible traits={budTraits} filterOptions={budFilterOptions} />
      </div>

      <div id="nftSubPets" style="display:none">
        <PetsCatalog
          client:visible
          commonPets={petsCommon}
          nftBreeds={petNftBreeds}
          nftTraits={petNftTraits}
          nftFilterOptions={petNftFilterOptions}
          fetches={petFetches}
          resources={petResources}
        />
      </div>

    </div>

    <!-- ═══════════════════════════════════════════════
         ГЛАВА
         ═══════════════════════════════════════════════ -->
    <div id="chapterPanel" style="display:none">
      <ChapterContent />
    </div>

    <!-- ═══════════════════════════════════════════════
         СООБЩЕСТВО
         ═══════════════════════════════════════════════ -->
    <div id="communityPanel" style="display:none">
      <div class="gc-codex-leaderboards">
        <div class="gc-card gc-codex-leaderboard-card">
          <div class="gc-codex-leaderboard-title">🎟️ Лидерборд тикетов</div>
          {ticketsTop5.length === 0 ? (
            <div class="gc-guides-empty" style="padding:24px 0;">Данные временно недоступны</div>
          ) : (
            ticketsTop5.map((entry, i) => (
              <div class="gc-codex-leaderboard-row">
                <span class="gc-codex-leaderboard-rank">{i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : i + 1}</span>
                <span class="gc-codex-leaderboard-name">{entry.game_username ?? `Ферма #${entry.farm_id}`}</span>
                <span class="gc-codex-leaderboard-score">{entry.tickets.toLocaleString('ru-RU')}</span>
              </div>
            ))
          )}
          <div class="gc-codex-leaderboard-footer">
            <a href="/codex/community/tickets-leaderboard" class="gc-codex-leaderboard-more">Смотреть полный рейтинг →</a>
            {formatUpdatedAgo(ticketsUpdatedAt) && (
              <span class="gc-codex-leaderboard-updated">{formatUpdatedAgo(ticketsUpdatedAt)}</span>
            )}
          </div>
        </div>

        <div class="gc-card gc-codex-leaderboard-card">
          <div class="gc-codex-leaderboard-title">💧 Лидерборд ликвидности</div>
          {lpTop5.length === 0 ? (
            <div class="gc-guides-empty" style="padding:24px 0;">Данные временно недоступны</div>
          ) : (
            lpTop5.map((entry, i) => (
              <div class="gc-codex-leaderboard-row">
                <span class="gc-codex-leaderboard-rank">{i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : i + 1}</span>
                <span class="gc-codex-leaderboard-name">{shortAddr(entry.owner)}</span>
                <span class="gc-codex-leaderboard-score">{entry.value_usd.toLocaleString('ru-RU', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 })}</span>
              </div>
            ))
          )}
          <div class="gc-codex-leaderboard-footer">
            <a href="/codex/community/lp-leaderboard" class="gc-codex-leaderboard-more">Смотреть полный рейтинг →</a>
            {formatUpdatedAgo(lpUpdatedAt) && (
              <span class="gc-codex-leaderboard-updated">{formatUpdatedAgo(lpUpdatedAt)}</span>
            )}
          </div>
        </div>
      </div>

      <h2 class="gc-block-title-lg">👥 Фермеры сообщества</h2>
      {communityApiError ? (
        <div class="gc-community-error gc-card">
          ⚠️ Данные временно недоступны. Попробуйте позже.
        </div>
      ) : (
        <CommunityPage client:load farmers={communityFarmers} guidesByUser={guidesByUser} />
      )}
    </div>

  </div>

  <!-- Вне .gc-content, чтобы position:fixed оверлея не зависел от вложенности -->
  <ChapterMechanicModal />
</BaseLayout>

<script>
  const sectionBtns    = document.querySelectorAll<HTMLAnchorElement>('.gc-section-tab');
  const sectionTabsEl  = document.getElementById('sectionTabs');
  const sectionDots    = document.querySelectorAll<HTMLSpanElement>('.gc-section-tabs-dot');
  const filterBtns     = document.querySelectorAll<HTMLButtonElement>('.gc-tag-btn');
  const cards          = document.querySelectorAll<HTMLElement>('.gc-guide-card');
  const countEl        = document.getElementById('guidesCount');
  const noResults      = document.getElementById('noResults');
  const emptySection   = document.getElementById('emptySection');
  const categoryFilter = document.getElementById('categoryFilter');
  const guidesGrid     = document.getElementById('guidesGrid');
  const mechanicsPanel = document.getElementById('mechanicsPanel');
  const nftPanel       = document.getElementById('nftPanel');
  const chapterPanel   = document.getElementById('chapterPanel');
  const communityPanel = document.getElementById('communityPanel');

  // NFT: подвкладки Предметы / Бады / Питомцы
  const nftSubtabs  = document.querySelectorAll<HTMLButtonElement>('#nftSubtabs .gc-nft-subtab');
  const nftSubItems = document.getElementById('nftSubItems');
  const nftSubBuds  = document.getElementById('nftSubBuds');
  const nftSubPets  = document.getElementById('nftSubPets');

  nftSubtabs.forEach(btn => {
    btn.addEventListener('click', () => {
      const sub = btn.dataset.nftSub;
      nftSubtabs.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      if (nftSubItems) nftSubItems.style.display = sub === 'items' ? '' : 'none';
      if (nftSubBuds)  nftSubBuds.style.display  = sub === 'buds' ? '' : 'none';
      if (nftSubPets)  nftSubPets.style.display  = sub === 'pets' ? '' : 'none';

      const url = new URL(window.location.href);
      url.searchParams.set('nftSub', sub ?? 'items');
      history.replaceState(null, '', url);
    });
  });

  // Механики: единый сайдбар на 10 пунктов — 8 таблиц (рендерит React-остров
  // ReferenceCatalog, ему просто передаём id через CustomEvent) + 2 markdown-
  // статьи (обычные Astro <article>, просто show/hide).
  const refNavItems  = document.querySelectorAll<HTMLAnchorElement>('.gc-ref-nav-item');
  const refTablesWrap = document.getElementById('gc-ref-tables-wrap');
  const refArticles   = document.querySelectorAll<HTMLElement>('[id^="mech-article-"]');

  refNavItems.forEach(item => {
    item.addEventListener('click', (e) => {
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();

      const kind = item.dataset.refKind;
      const id = item.dataset.refId;

      refNavItems.forEach(b => b.classList.remove('active'));
      item.classList.add('active');

      if (kind === 'table') {
        if (refTablesWrap) refTablesWrap.style.display = '';
        refArticles.forEach(a => { a.style.display = 'none'; });
        window.dispatchEvent(new CustomEvent('gc:ref-select', { detail: id }));

        const url = new URL(window.location.href);
        url.searchParams.set('tab', 'mechanics');
        url.searchParams.set('ref', id ?? '');
        url.searchParams.delete('mech');
        history.replaceState(null, '', url);
      } else {
        if (refTablesWrap) refTablesWrap.style.display = 'none';
        refArticles.forEach(a => {
          a.style.display = a.id === `mech-article-${id}` ? '' : 'none';
        });

        const url = new URL(window.location.href);
        url.searchParams.set('tab', 'mechanics');
        url.searchParams.set('mech', id ?? '');
        url.searchParams.delete('ref');
        history.replaceState(null, '', url);
      }
    });
  });

  // Переключатель RU/EN для названий бонусов — общий для всех трёх вкладок
  // NFT-раздела (Предметы/Бады/Питомцы). Они гидрируются как отдельные React-
  // острова без общего состояния, поэтому синхронизация идёт через
  // localStorage + CustomEvent, а не через пропсы.
  const BOOST_LANG_KEY   = 'gc-boost-lang';
  const BOOST_LANG_EVENT = 'gc:boost-lang-change';
  const langToggle = document.getElementById('langToggle');
  const langBtns    = document.querySelectorAll<HTMLButtonElement>('.gc-lang-btn');
  const storedLang  = localStorage.getItem(BOOST_LANG_KEY) === 'en' ? 'en' : 'ru';
  langBtns.forEach(b => b.classList.toggle('active', b.dataset.lang === storedLang));

  langToggle?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.gc-lang-btn');
    if (!btn) return;
    const lang = btn.dataset.lang ?? 'ru';
    langBtns.forEach(b => b.classList.toggle('active', b === btn));
    localStorage.setItem(BOOST_LANG_KEY, lang);
    window.dispatchEvent(new CustomEvent(BOOST_LANG_EVENT, { detail: lang }));
  });

  function isPlainLeftClick(e: MouseEvent): boolean {
    return e.button === 0 && !e.metaKey && !e.ctrlKey && !e.shiftKey && !e.altKey;
  }

  let activeSection  = 'guides';
  let activeCategory = 'all';

  function showSection(section: string) {
    const isGuides    = section === 'guides';
    const isMechanics = section === 'mechanics';
    const isNft       = section === 'nft';
    const isChapter   = section === 'chapter';
    const isCommunity = section === 'community';

    if (guidesGrid)     guidesGrid.style.display     = isGuides ? '' : 'none';
    if (categoryFilter) (categoryFilter as HTMLElement).style.display = isGuides ? '' : 'none';
    if (countEl)        countEl.style.display         = isGuides ? '' : 'none';
    if (noResults)      noResults.style.display       = 'none';
    if (emptySection)   emptySection.style.display    = 'none';
    if (mechanicsPanel) mechanicsPanel.style.display  = isMechanics ? 'flex' : 'none';
    if (nftPanel)       nftPanel.style.display        = isNft ? '' : 'none';
    if (chapterPanel)   chapterPanel.style.display    = isChapter ? '' : 'none';
    if (communityPanel) communityPanel.style.display  = isCommunity ? '' : 'none';
  }

  function getCategories(section: string): string[] {
    const cats = new Set<string>();
    cards.forEach(card => {
      if (card.dataset.section === section) cats.add(card.dataset.category ?? '');
    });
    return [...cats].filter(Boolean);
  }

  function updateCategoryButtons(section: string) {
    const btns = categoryFilter?.querySelectorAll('.gc-tag-btn:not([data-cat="all"])');
    btns?.forEach(b => b.remove());
    getCategories(section).forEach(cat => {
      const btn = document.createElement('button');
      btn.className = 'gc-tag-btn';
      btn.dataset.cat = cat;
      btn.textContent = cat;
      btn.addEventListener('click', () => {
        activeCategory = cat;
        categoryFilter?.querySelectorAll('.gc-tag-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        filterCards();
      });
      categoryFilter?.appendChild(btn);
    });
    activeCategory = 'all';
    categoryFilter?.querySelector('[data-cat="all"]')?.classList.add('active');
  }

  function filterCards() {
    let visible = 0;
    cards.forEach(card => {
      const sec  = card.dataset.section ?? 'guides';
      const cat  = card.dataset.category ?? '';
      const show = sec === activeSection
        && (activeCategory === 'all' || cat === activeCategory);
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (countEl) countEl.textContent = `Показано: ${visible} гайдов`;
    const totalInSection = [...cards].filter(c => c.dataset.section === activeSection).length;
    if (noResults)    noResults.style.display    = visible === 0 && totalInSection > 0 ? 'block' : 'none';
    if (emptySection) emptySection.style.display = totalInSection === 0 ? 'block' : 'none';
  }

  function setActiveDot(index: number) {
    sectionDots.forEach((d, i) => d.classList.toggle('active', i === index));
  }

  sectionBtns.forEach((btn, index) => {
    btn.addEventListener('click', (e) => {
      if (!isPlainLeftClick(e)) return;
      e.preventDefault();

      activeSection = btn.dataset.section ?? 'guides';
      sectionBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      setActiveDot(index);
      btn.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });

      showSection(activeSection);

      const url = new URL(window.location.href);
      url.searchParams.set('tab', activeSection);
      if (activeSection !== 'mechanics') url.searchParams.delete('mech');
      history.replaceState(null, '', url);

      if (activeSection === 'guides') {
        updateCategoryButtons(activeSection);
        filterCards();
      }
    });
  });

  // Мобильный горизонтальный скролл вкладок: полоски-индикаторы под ним —
  // чисто визуальная подсказка позиции при свайпе, обновляются по ближайшей
  // к центру видимой области плитке (не переключают саму вкладку — для
  // этого нужен клик/тап по плитке).
  if (sectionTabsEl) {
    let scrollRaf = 0;
    sectionTabsEl.addEventListener('scroll', () => {
      if (scrollRaf) cancelAnimationFrame(scrollRaf);
      scrollRaf = requestAnimationFrame(() => {
        const containerCenter = sectionTabsEl.getBoundingClientRect().left + sectionTabsEl.clientWidth / 2;
        let closestIndex = 0;
        let closestDist = Infinity;
        sectionBtns.forEach((btn, i) => {
          const btnCenter = btn.getBoundingClientRect().left + btn.clientWidth / 2;
          const dist = Math.abs(btnCenter - containerCenter);
          if (dist < closestDist) { closestDist = dist; closestIndex = i; }
        });
        setActiveDot(closestIndex);
      });
    }, { passive: true });
  }

  categoryFilter?.querySelector('[data-cat="all"]')?.addEventListener('click', () => {
    activeCategory = 'all';
    categoryFilter?.querySelectorAll('.gc-tag-btn').forEach(b => b.classList.remove('active'));
    categoryFilter?.querySelector('[data-cat="all"]')?.classList.add('active');
    filterCards();
  });

  // Инициализация: проверяем ?tab=, ?mech=, ?ref= и ?nftSub= параметры.
  // ?tab=reference — старый путь (вкладка "Справочник" до объединения с
  // "Механики"); маппим на "Механики".
  const initialParams = new URLSearchParams(window.location.search);
  let urlTab      = initialParams.get('tab');
  const urlMech   = initialParams.get('mech');
  const urlRef    = initialParams.get('ref');
  const urlNftSub = initialParams.get('nftSub');

  if (urlTab === 'reference') {
    urlTab = 'mechanics';
  }

  if (urlTab) {
    const targetBtn = [...sectionBtns].find(b => b.dataset.section === urlTab);
    if (targetBtn) {
      targetBtn.click();
    } else {
      updateCategoryButtons('guides');
      filterCards();
    }
  } else {
    updateCategoryButtons('guides');
    filterCards();
  }

  if (urlTab === 'nft' && urlNftSub) {
    const targetSub = [...nftSubtabs].find(b => b.dataset.nftSub === urlNftSub);
    targetSub?.click();
  }

  // Общий сайдбар механик: ?mech= — открыть конкретную markdown-статью,
  // ?ref= — конкретную таблицу (по умолчанию активен первый пункт — таблица
  // "Навыки" — так что явный клик нужен только если параметр отличается).
  // ?mech=update-nodes — старая ссылка на статью, смерджённую в таблицу
  // "Улучшение ресурсных нод" (ref=upgrades), маппим на неё.
  const effectiveRef = urlMech === 'update-nodes' ? 'upgrades' : urlRef;
  if (urlTab === 'mechanics' && urlMech && urlMech !== 'update-nodes') {
    const targetItem = [...refNavItems].find(b => b.dataset.refKind === 'article' && b.dataset.refId === urlMech);
    targetItem?.click();
  } else if (urlTab === 'mechanics' && effectiveRef) {
    const targetItem = [...refNavItems].find(b => b.dataset.refKind === 'table' && b.dataset.refId === effectiveRef);
    targetItem?.click();
  }
</script>

