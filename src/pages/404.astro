---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Гоблин заблудился | GoblinCodex" currentPage="">
  <div class="page-404">
    <div class="card">
      <div class="card-top-border"></div>

      <div class="num-404">
        <span class="digit" data-char="4">4</span>
        <span class="digit zero" data-char="0">0</span>
        <span class="digit" data-char="4">4</span>
      </div>

      <div class="goblin-wrap">
        <img src="/images/UsualGoblin.png" alt="Goblin" class="goblin-img" />
      </div>

      <div class="badge">
        <span class="badge-dot"></span>
        Страница не найдена
      </div>

      <h1 class="error-title">Гоблин заблудился<span class="blink-cursor">|</span></h1>

      <p class="error-desc">
        Эта страница исчезла в тумане войны или никогда не<br />
        существовала. Возможно, ссылка устарела или вы сделали<br />
        опечатку в адресе.
      </p>

      <div class="url-box">
        <span class="url-x">✕</span>
        <span class="url-text" id="current-url"></span>
      </div>

      <div class="btn-group">
        <a href="/" class="btn btn-primary">На главную</a>
        <button class="btn btn-secondary" onclick="history.back()">Назад</button>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  document.getElementById('current-url')!.textContent = window.location.pathname;
</script>

<style>
  .page-404 {
    min-height: calc(100vh - 120px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
  }

  .card {
    background: #faf5eb;
    border-radius: 20px;
    max-width: 560px;
    width: 100%;
    padding: 0 40px 40px;
    text-align: center;
    position: relative;
    overflow: hidden;
    box-shadow: 0 8px 40px rgba(0,0,0,0.12);
    animation: cardIn 0.5s ease-out both;
  }

  .card-top-border {
    height: 6px;
    background: linear-gradient(90deg, #e04a2f 33%, #f0c040 33% 66%, #4a9e3f 66%);
    margin: 0 -40px 32px;
    border-radius: 20px 20px 0 0;
  }

  /* ───── 404 числа ───── */
  .num-404 {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-bottom: 24px;
  }

  .digit {
    font-family: 'Press Start 2P', monospace;
    font-size: clamp(48px, 10vw, 80px);
    color: #2d6e1f;
    display: inline-block;
    position: relative;
    text-shadow:
      3px 3px 0 #1a4a0f,
      -1px -1px 0 #4a9e3f;
    animation: digitFloat 3s ease-in-out infinite;
  }

  .digit:nth-child(1) { animation-delay: 0s; }
  .digit.zero        { animation-delay: 0.15s; }
  .digit:nth-child(3){ animation-delay: 0.3s; }

  /* Глитч слой */
  .digit::before,
  .digit::after {
    content: attr(data-char);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    font-family: inherit;
    font-size: inherit;
  }

  .digit::before {
    color: #e04a2f;
    clip-path: polygon(0 15%, 100% 15%, 100% 40%, 0 40%);
    animation: glitch-top 4s steps(1) infinite;
    opacity: 0;
  }

  .digit::after {
    color: #2563eb;
    clip-path: polygon(0 60%, 100% 60%, 100% 80%, 0 80%);
    animation: glitch-bot 4s steps(1) infinite;
    opacity: 0;
  }

  /* ───── Гоблин ───── */
  .goblin-wrap {
    margin: 0 auto 20px;
    width: 80px;
    animation: goblinFloat 2.5s ease-in-out infinite;
  }

  .goblin-img {
    width: 100%;
    image-rendering: pixelated;
  }

  /* ───── Бейдж ───── */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #fde8e4;
    color: #c0392b;
    border-radius: 20px;
    padding: 4px 14px;
    font-size: 0.78rem;
    font-family: 'Golos Text', sans-serif;
    font-weight: 500;
    margin-bottom: 16px;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #e04a2f;
    animation: blink 1.2s ease-in-out infinite;
  }

  /* ───── Заголовок ───── */
  .error-title {
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(1.1rem, 3vw, 1.5rem);
    font-weight: 700;
    color: #1a2e1a;
    margin-bottom: 14px;
  }

  .blink-cursor {
    animation: blink 1s step-end infinite;
    color: #4a9e3f;
    margin-left: 2px;
  }

  /* ───── Описание ───── */
  .error-desc {
    font-family: 'Golos Text', sans-serif;
    font-size: 0.92rem;
    color: #5a6a4a;
    line-height: 1.7;
    margin-bottom: 20px;
  }

  /* ───── URL box ───── */
  .url-box {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #f0f0e8;
    border: 1px solid #d0ccc0;
    border-radius: 8px;
    padding: 8px 14px;
    font-family: monospace;
    font-size: 0.82rem;
    color: #6a6a5a;
    margin-bottom: 28px;
    max-width: 100%;
    overflow: hidden;
  }

  .url-x {
    color: #e04a2f;
    font-weight: bold;
    flex-shrink: 0;
  }

  .url-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ───── Кнопки ───── */
  .btn-group {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    padding: 12px 28px;
    border-radius: 10px;
    font-family: 'Golos Text', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: transform 0.15s, box-shadow 0.15s;
    text-decoration: none;
    display: inline-block;
  }

  .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.15);
  }

  .btn:active { transform: translateY(0); }

  .btn-primary {
    background: #2d6e1f;
    color: #fff;
  }

  .btn-secondary {
    background: transparent;
    color: #2d6e1f;
    border: 2px solid #2d6e1f;
  }

  /* ───── Анимации ───── */
  @keyframes cardIn {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes digitFloat {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-8px); }
  }

  @keyframes goblinFloat {
    0%, 100% { transform: translateY(0) rotate(-3deg); }
    50%       { transform: translateY(-10px) rotate(3deg); }
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }

  @keyframes glitch-top {
    0%, 89%       { opacity: 0; transform: translate(0); }
    90%           { opacity: 1; transform: translate(-3px, -2px); }
    92%           { opacity: 1; transform: translate(3px, 2px); }
    94%           { opacity: 1; transform: translate(-2px, 0); }
    96%, 100%     { opacity: 0; transform: translate(0); }
  }

  @keyframes glitch-bot {
    0%, 91%       { opacity: 0; transform: translate(0); }
    92%           { opacity: 1; transform: translate(3px, 1px); }
    94%           { opacity: 1; transform: translate(-3px, -1px); }
    96%, 100%     { opacity: 0; transform: translate(0); }
  }

  @media (max-width: 480px) {
    .card { padding: 0 20px 30px; }
    .card-top-border { margin: 0 -20px 24px; }
    .error-desc br { display: none; }
  }
</style>
