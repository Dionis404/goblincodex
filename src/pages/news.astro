---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogLayout from '../layouts/BlogLayout.astro';
import ArticleReaderOverlay from '../components/ArticleReaderOverlay.astro';
import TelegramPostModal from '../components/TelegramPostModal.astro';
import { fetchMergedNews } from '../lib/news-feed';
import { isBlogHost } from '../lib/blog-domain';
import { getEntryByShortId } from '../lib/news-lookup';

const { items: news, tagsByGame } = await fetchMergedNews({ telegramLimit: 100 });
const telegramPosts = news.filter(n => n.source === 'telegram');

const GAME_LABELS: Record<string, string> = {
  sunflower: 'Sunflower Land',
  yakkamon: 'Yakkamon',
  telegram: 'Телеграм',
};

// blog.goblincodex.fun/.ru — бывший Teletype-домен, теперь просто зеркало
// /news под минимальным layout (без шапки/футера основного сайта). Middleware
// переписывает "/" на "/news" для этих хостов, но выбор layout делается
// здесь же, по тому же Host — так /news напрямую на blog.* тоже работает.
const onBlogHost = isBlogHost(Astro.request.headers.get('host'));
const Layout = onBlogHost ? BlogLayout : BaseLayout;

// Легаси-диплинк ?article=<id> (старые расшаренные/закэшированные ссылки —
// основной путь уже перехватывается 301-редиректом в middleware, это лишь
// подстраховка) — подменяем SEO/OG-мету на данные статьи, чтобы шаринг
// всё равно показывал превью с заголовком, описанием и картинкой статьи,
// а не общую заглушку страницы /news.
const articleId = Astro.url.searchParams.get('article');
const articleEntry = articleId ? await getEntryByShortId(articleId) : undefined;

const seoTitle = articleEntry && !articleEntry.data.draft
  ? `${articleEntry.data.title} — GoblinCodex`
  : 'Новости Sunflower Land — GoblinCodex';
const seoDescription = articleEntry && !articleEntry.data.draft
  ? articleEntry.data.description
  : 'Последние новости и обновления игры Sunflower Land на русском языке.';
const seoImage = articleEntry && !articleEntry.data.draft ? articleEntry.data.image : undefined;
// Canonical URL статьи — /news/{shortId} (настоящий SSR-маршрут, см.
// src/pages/news/[id].astro), а не /news?article=id — так шаринг
// с любой из точек входа (оверлей на /news, легаси-диплинк, прямая ссылка)
// указывает на один и тот же URL.
const seoShareUrl = articleEntry && !articleEntry.data.draft ? `/news/${articleEntry.data.shortId}` : undefined;
---

<Layout
  {...(onBlogHost ? {} : { currentPage: 'news' })}
  title={seoTitle}
  description={seoDescription}
  image={seoImage}
  type={articleEntry ? 'article' : 'website'}
  shareUrl={seoShareUrl}
>
  <div class="gc-content gc-page-enter">

    <div class="gc-news-page-header">
      <h1 class="gc-page-title">🔥 Новости Sunflower Land</h1>
      <p class="gc-news-page-sub">Актуальные обновления, стримы и события из мира SFL</p>
    </div>

    <!-- Верхний фильтр: игра -->
    <div class="gc-tag-filter" id="gameFilter">
      <button class="gc-tag-btn active" data-game="all">Всё</button>
      {Object.entries(GAME_LABELS).map(([game, label]) => (
        <button class="gc-tag-btn" data-game={game}>{label}</button>
      ))}
    </div>

    <!-- Второй фильтр: подтег внутри выбранной игры -->
    {Object.entries(tagsByGame).map(([game, gameTags]) => gameTags.length > 0 && (
      <div class="gc-tag-filter gc-subtag-filter" data-parent-game={game} style="display:none">
        <button class="gc-tag-btn gc-tag-btn--sub active" data-tag="all">Всё</button>
        {gameTags.map(tag => (
          <button class="gc-tag-btn gc-tag-btn--sub" data-tag={tag}>{tag}</button>
        ))}
      </div>
    ))}

    {news.length === 0 ? (
      <div class="gc-news-empty">Не удалось загрузить новости. Попробуйте позже.</div>
    ) : (
      <div class="gc-news-grid" id="newsGrid">
        {news.map(item => (
          <a
            href={item.link}
            class="gc-card gc-card-hover gc-news-card"
            data-tag={item.tag}
            data-game={item.game}
            data-source={item.source}
            data-slug={item.slug ?? ''}
          >
            {item.image && (
              <div class="gc-news-card-img">
                <img src={item.image} alt={item.title} loading="lazy" />
              </div>
            )}
            <div class="gc-news-card-body">
              <div class="gc-news-card-meta">
                {item.tag && <span class={`gc-tag gc-tag--${item.tagColor}`}>{item.tag}</span>}
                <span class="gc-news-card-date">{item.dateLabel}</span>
              </div>
              <div class="gc-news-card-title">{item.title}</div>
              {item.desc && <div class="gc-news-card-desc">{item.desc}</div>}
            </div>
          </a>
        ))}
      </div>
    )}

  </div>

  <ArticleReaderOverlay />
  <TelegramPostModal posts={telegramPosts} />
</Layout>

<script>
  const gameBtns    = document.querySelectorAll<HTMLButtonElement>('#gameFilter .gc-tag-btn');
  const subFilters  = document.querySelectorAll<HTMLElement>('.gc-subtag-filter');
  const cards       = document.querySelectorAll<HTMLElement>('.gc-news-card');

  let selectedGame = 'all';
  let selectedTag  = 'all';

  function applyFilter() {
    cards.forEach(card => {
      const gameMatch = selectedGame === 'all' || card.dataset.game === selectedGame;
      const tagMatch  = selectedTag === 'all' || card.dataset.tag === selectedTag;
      card.style.display = (gameMatch && tagMatch) ? '' : 'none';
    });
  }

  function showSubFilterFor(game: string) {
    subFilters.forEach(group => {
      group.style.display = group.dataset.parentGame === game ? 'flex' : 'none';
    });
  }

  gameBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      selectedGame = btn.dataset.game ?? 'all';
      selectedTag = 'all';

      gameBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      showSubFilterFor(selectedGame);
      // Сбрасываем активную кнопку в подфильтре выбранной игры на "Всё"
      subFilters.forEach(group => {
        if (group.dataset.parentGame !== selectedGame) return;
        group.querySelectorAll<HTMLButtonElement>('.gc-tag-btn').forEach(b => {
          b.classList.toggle('active', b.dataset.tag === 'all');
        });
      });

      applyFilter();
    });
  });

  subFilters.forEach(group => {
    group.querySelectorAll<HTMLButtonElement>('.gc-tag-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        selectedTag = btn.dataset.tag ?? 'all';
        group.querySelectorAll<HTMLButtonElement>('.gc-tag-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        applyFilter();
      });
    });
  });

  cards.forEach(card => {
    card.addEventListener('click', (e) => {
      const source = card.dataset.source;
      if (source === 'news') {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent('gc:open-article', { detail: card.dataset.slug }));
      } else if (source === 'telegram') {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent('gc:open-tg-modal', { detail: card.getAttribute('href') }));
      }
    });
  });
</script>

<style>
.gc-news-page-header {
  padding: 40px 0 24px;
}
.gc-news-page-sub {
  font-size: 15px;
  color: var(--text-sec);
  margin-top: 6px;
}

/* ── Фильтр тегов ── */
.gc-tag-filter {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 28px;
}
.gc-tag-btn {
  padding: 7px 16px;
  border-radius: 20px;
  border: 1px solid var(--border);
  background: var(--card-bg);
  color: var(--text-sec);
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  font-family: var(--font-body);
  transition: all 0.15s;
}
.gc-tag-btn:hover {
  border-color: var(--green-mid);
  color: var(--green-dark);
  background: var(--green-pale);
}
.gc-tag-btn.active {
  background: var(--green-dark);
  color: var(--green-pale);
  border-color: var(--green-dark);
}
.gc-subtag-filter {
  margin-top: -16px;
}
.gc-tag-btn--sub {
  padding: 5px 13px;
  font-size: 12px;
}
.gc-tag-btn--sub.active {
  background: var(--green-mid);
  border-color: var(--green-mid);
}

/* ── Сетка ── */
.gc-news-empty {
  padding: 48px;
  text-align: center;
  color: var(--text-sec);
}
.gc-news-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-bottom: 48px;
}
.gc-news-card {
  text-decoration: none;
  color: var(--text);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.gc-news-card-img {
  width: 100%;
  aspect-ratio: 16/9;
  overflow: hidden;
}
.gc-news-card-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s;
}
.gc-news-card:hover .gc-news-card-img img {
  transform: scale(1.04);
}
.gc-news-card-body {
  padding: 16px;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.gc-news-card-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.gc-news-card-date {
  font-size: 11px;
  color: var(--text-sec);
}
.gc-news-card-title {
  font-size: 14px;
  font-weight: 600;
  line-height: 1.4;
  color: var(--text);
}
.gc-news-card-desc {
  font-size: 12px;
  color: var(--text-sec);
  line-height: 1.5;
}

@media (max-width: 900px) {
  .gc-news-grid { grid-template-columns: repeat(2, 1fr) !important; }
}
@media (max-width: 640px) {
  .gc-news-grid { grid-template-columns: 1fr !important; }
  .gc-news-page-header { padding: 24px 0 16px; }
}
</style>