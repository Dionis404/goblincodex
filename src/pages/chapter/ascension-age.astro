---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, getEntry, render } from 'astro:content';
import ChapterAuctions from '../../components/ChapterAuctions.tsx';
import auctionsData from '../../data/next-chapter-auctions.json';
import type { getCatalogItems } from '../../lib/db';
import { getCachedCatalogItems } from '../../lib/catalog-cache';

const NEXT_CHAPTER = 15;

let itemCatalog: Record<string, Awaited<ReturnType<typeof getCatalogItems>>[number]> = {};
try {
  const { data: items } = await getCachedCatalogItems();
  itemCatalog = Object.fromEntries(items.map((i) => [i.name, i]));
} catch (err) {
  console.error('[chapter/ascension-age] DB fetch error:', err);
}

const chapterGuides = await getCollection(
  'guides',
  ({ data }) => !data.draft && data.chapter === NEXT_CHAPTER
);
chapterGuides.sort((a, b) => new Date(b.data.publishDate ?? '').getTime() - new Date(a.data.publishDate ?? '').getTime());

const auctions: any[] = auctionsData.auctions.auctions;
const now = Date.now();

const CHAPTER_TAG = 'chapter-ascension-age';
const chapterItems = Object.values(itemCatalog)
  .filter((i) => i.tags?.includes(CHAPTER_TAG))
  .sort((a, b) => a.name.localeCompare(b.name));

// ── Основные механики: карточки, открывающие гайд из кодекса в модалке ──
const MECHANIC_CARDS = [
  { id: 'delivery',     icon: '🚚', title: 'Доставки' },
  { id: 'auction',      icon: '🔨', title: 'Аукционы' },
  { id: 'raffle',       icon: '🎟️', title: 'Рафлы' },
  { id: 'bounty-board', icon: '📋', title: 'Баунтиборд' },
  { id: 'chore',        icon: '✅', title: 'Chore (задания)' },
  { id: 'chapter-pass', icon: '🎫', title: 'Чаптерпасс' },
];

const mechanicCards = await Promise.all(
  MECHANIC_CARDS.map(async (card) => {
    const entry = await getEntry('mechanics', card.id);
    const Content = entry ? (await render(entry)).Content : null;
    return { ...card, Content };
  })
);
---

<BaseLayout
  currentPage="chapter"
  title="Ascension Age — GoblinCodex"
  description="Гайды по механике будущей главы Ascension Age, предметы и расписание аукционов Sunflower Land."
>
  <div class="gc-content gc-page-enter">

    <div class="gc-chapter-block">
      <div class="gc-chapter-banner gc-chapter-banner--placeholder">
        <img src="/sprites/decorations/banners/ascension_banner.webp" alt="Ascension Age — Chapter 15" class="gc-chapter-img gc-chapter-img--icon" />
      </div>
    </div>

    <div class="gc-wip-note">
      <span class="gc-wip-note-dot"></span>
      🔜 Глава Ascension Age ещё не началась (старт 2026-08-03, сразу после Salt Awakening) — часть данных уточняется по мере анонсов разработчиков
    </div>

    <!-- ── Основные механики ── -->
    <section class="gc-chapter-section">
      <h2 class="gc-block-title-lg">⚙️ Основные механики</h2>
      <div class="gc-mechanics-grid">
        {mechanicCards.map(card => (
          <button type="button" class="gc-mechanic-card" data-mech-open={card.id}>
            <div class="gc-mechanic-icon">{card.icon}</div>
            <div class="gc-mechanic-title">{card.title}</div>
          </button>
        ))}
      </div>
    </section>

    <!-- ── Гайды по механике главы ── -->
    <section class="gc-chapter-section">
      <h2 class="gc-block-title-lg">📗 Гайды по механике главы</h2>
      {chapterGuides.length > 0 ? (
        <div class="gc-guides-grid">
          {chapterGuides.map(guide => (
            <a href={`/codex/${guide.id}`} class="gc-card gc-card-hover gc-guide-card">
              <div class="gc-guide-card-top">
                <div class="gc-guide-card-icon">{guide.data.icon}</div>
                <div class="gc-guide-card-info">
                  <div class="gc-guide-card-title">{guide.data.title}</div>
                  <div class="gc-guide-card-meta">
                    <span class="gc-tag gc-tag--green">{guide.data.category}</span>
                    <span class="gc-guide-card-time">⏱ {guide.data.readTime} мин</span>
                  </div>
                </div>
              </div>
              <div class="gc-guide-card-desc">{guide.data.description}</div>
            </a>
          ))}
        </div>
      ) : (
        <div class="gc-guides-empty">
          Гайдов по этой главе пока нет. Загляни в <a href="/codex">Кодекс</a> за общими гайдами.
        </div>
      )}
    </section>

    <!-- ── Предметы главы ── -->
    <section class="gc-chapter-section">
      <h2 class="gc-block-title-lg">💎 Предметы главы</h2>
      {chapterItems.length > 0 ? (
        <div class="gc-chapter-items-grid">
          {chapterItems.map((item) => (
            <div class="gc-chapter-item-card">
              <div class="gc-chapter-item-sprite">
                {item.sprite ? (
                  <img src={`/sprites/${item.sprite}`} alt={item.name} loading="lazy" />
                ) : (
                  <span class="gc-chapter-item-sprite-placeholder">?</span>
                )}
              </div>
              <div class="gc-chapter-item-info">
                <div class="gc-chapter-item-name">{item.name}</div>
                {item.boosts.length > 0 ? (
                  <div class="gc-chapter-item-boosts">
                    {item.boosts.map((b) => (
                      <span class={`gc-chapter-item-boost gc-chapter-item-boost--${b.labelType}`}>
                        {b.shortDescriptionRu || b.shortDescription}
                      </span>
                    ))}
                  </div>
                ) : (
                  <span class="gc-chapter-item-no-boost">Без бонусов</span>
                )}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="gc-guides-empty">
          Каталог предметов главы скоро появится здесь — данные будут подгружаться из базы.
        </div>
      )}
    </section>

    <!-- ── Расписание аукционов ── -->
    <section class="gc-chapter-section">
      <ChapterAuctions client:load auctions={auctions} chapterName="Ascension Age" itemCatalog={itemCatalog} initialNow={now} />
    </section>

  </div>

  <!-- ── Модалка гайда по механике (вне gc-content, чтобы position:fixed считался от вьюпорта) ── -->
  <div class="gc-modal-overlay gc-mech-modal-overlay" id="mechModalOverlay" style="display:none">
    <div class="gc-modal-box gc-mech-modal-box" id="mechModalBox">
      <button type="button" class="gc-modal-close" id="mechModalClose" aria-label="Закрыть">✕</button>
      <div class="gc-mech-modal-scroll">
        {mechanicCards.map(card => {
          const CardContent = card.Content;
          return (
            <div class="gc-mech-modal-article" data-mech-article={card.id} style="display:none">
              <h3 class="gc-mech-modal-title">{card.icon} {card.title}</h3>
              <article class="gc-guide-article">
                {CardContent ? <CardContent /> : <p>Гайд в разработке — скоро появится здесь.</p>}
              </article>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
:global(.gc-chapter-img) {
  width: 100%;
  height: auto;
  display: block;
  image-rendering: pixelated;
}
:global(.gc-chapter-img--icon) {
  width: 96px;
  height: 96px;
  margin: 0 auto;
}

.gc-chapter-block {
  position: relative;
  margin-bottom: 32px;
}
.gc-chapter-banner {
  width: 100%;
  line-height: 0;
  filter: drop-shadow(0 8px 24px rgba(0,0,0,0.25));
  border-radius: 12px;
  overflow: hidden;
}
.gc-chapter-banner--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px;
  background: var(--card-bg);
  border: 1px solid var(--border);
}

.gc-wip-note {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--amber-pale);
  border: 1px solid var(--amber);
  border-radius: 10px;
  padding: 12px 18px;
  margin-bottom: 32px;
  font-size: 13px;
  color: var(--text);
  line-height: 1.5;
}
.gc-wip-note-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--text-ter);
  flex-shrink: 0;
  animation: gc-wip-note-pulse 1.8s ease-in-out infinite;
}
@keyframes gc-wip-note-pulse {
  0%, 100% { opacity: 1; }
  50%      { opacity: 0.3; }
}

.gc-chapter-section { margin-bottom: 40px; }
.gc-block-title-lg {
  font-family: var(--font-head);
  font-size: 18px;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 16px;
}

/* ── Основные механики ── */
.gc-mechanics-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 16px;
}
.gc-mechanic-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  padding: 20px 12px;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
  text-align: center;
  cursor: pointer;
  font: inherit;
  transition: border-color 0.15s, transform 0.15s;
}
.gc-mechanic-card:hover {
  border-color: var(--green-mid);
  transform: translateY(-2px);
}
.gc-mechanic-icon {
  font-size: 28px;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--green-pale);
  border-radius: 10px;
}
.gc-mechanic-title {
  font-size: 12px;
  font-weight: 600;
  color: var(--text);
  line-height: 1.4;
}
@media (max-width: 900px) {
  .gc-mechanics-grid { grid-template-columns: repeat(3, 1fr) !important; }
}
@media (max-width: 640px) {
  .gc-mechanics-grid { grid-template-columns: repeat(2, 1fr) !important; }
}

/* ── Сетка гайдов (как в /codex) ── */
.gc-guides-empty {
  padding: 32px;
  text-align: center;
  color: var(--text-sec);
  font-size: 14px;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
}
.gc-guides-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}
.gc-guide-card {
  text-decoration: none;
  color: var(--text);
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.gc-guide-card-top {
  display: flex;
  align-items: flex-start;
  gap: 14px;
}
.gc-guide-card-icon {
  font-size: 28px;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--green-pale);
  border-radius: 10px;
}
.gc-guide-card-info { flex: 1; }
.gc-guide-card-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 6px;
  line-height: 1.4;
}
.gc-guide-card-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.gc-guide-card-time { font-size: 11px; color: var(--text-sec); }
.gc-guide-card-desc { font-size: 12px; color: var(--text-sec); line-height: 1.5; }

@media (max-width: 900px) {
  .gc-guides-grid { grid-template-columns: repeat(2, 1fr) !important; }
}
@media (max-width: 640px) {
  .gc-guides-grid { grid-template-columns: 1fr !important; }
}

/* ── Предметы главы ── */
.gc-chapter-items-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 14px;
}
.gc-chapter-item-card {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 14px;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
}
.gc-chapter-item-sprite {
  width: 44px;
  height: 44px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg);
  border-radius: 8px;
}
.gc-chapter-item-sprite img {
  width: 36px;
  height: 36px;
  object-fit: contain;
  image-rendering: pixelated;
}
.gc-chapter-item-sprite-placeholder {
  color: var(--text-ter);
  font-size: 16px;
}
.gc-chapter-item-info {
  flex: 1;
  min-width: 0;
}
.gc-chapter-item-name {
  font-size: 13px;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 6px;
}
.gc-chapter-item-boosts {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}
.gc-chapter-item-boost {
  font-size: 10px;
  font-weight: 600;
  padding: 2px 7px;
  border-radius: 5px;
  background: var(--green-pale);
  color: var(--green-dark);
}
.gc-chapter-item-boost--danger {
  background: color-mix(in srgb, var(--red, #c94b3d) 14%, transparent);
  color: var(--red, #c94b3d);
}
.gc-chapter-item-boost--vibrant {
  background: var(--amber-pale);
  color: var(--amber);
}
.gc-chapter-item-no-boost {
  font-size: 11px;
  color: var(--text-ter);
}

/* ── Модалка гайда по механике ── */
.gc-mech-modal-box {
  max-width: 720px;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 0;
  /* Скругление живёт на внешнем боксе с overflow:hidden — скролл идёт во
     вложенном .gc-mech-modal-scroll, иначе скроллбар браузера обрезает
     угол некрасивой прямой линией поверх border-radius. */
  overflow: hidden;
  max-height: 90vh;
}
.gc-mech-modal-scroll {
  max-height: 90vh;
  overflow-y: auto;
  padding: 32px 36px;
}
.gc-mech-modal-title {
  font-family: var(--font-head);
  font-size: 22px;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 16px;
}
.gc-mech-modal-article .gc-guide-article {
  padding: 0;
  border: none;
  box-shadow: none;
  background: transparent;
}
@media (max-width: 640px) {
  .gc-mech-modal-scroll { padding: 24px 20px; }
}
</style>

<script>
  const mechButtons  = document.querySelectorAll<HTMLButtonElement>('[data-mech-open]');
  const mechOverlay  = document.getElementById('mechModalOverlay');
  const mechClose    = document.getElementById('mechModalClose');
  const mechArticles = document.querySelectorAll<HTMLElement>('[data-mech-article]');

  function openMechModal(id: string) {
    mechArticles.forEach(a => {
      a.style.display = a.dataset.mechArticle === id ? 'block' : 'none';
    });
    if (mechOverlay) mechOverlay.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closeMechModal() {
    if (mechOverlay) mechOverlay.style.display = 'none';
    document.body.style.overflow = '';
  }

  mechButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.mechOpen;
      if (id) openMechModal(id);
    });
  });

  mechClose?.addEventListener('click', closeMechModal);
  mechOverlay?.addEventListener('click', (e) => {
    if (e.target === mechOverlay) closeMechModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMechModal();
  });
</script>
