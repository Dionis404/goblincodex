---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  currentPage="codex"
  title="Прошлые главы Sunflower Land | GoblinCodex"
  description="Архив прошлых глав Sunflower Land — история сезонов, механик и событий."
>
  <div class="gc-content gc-page-enter">

    <a href="/codex?tab=chapter" class="gc-btn-secondary gc-past-back">← Текущая глава</a>

    <div class="gc-past-header">
      <h1 class="gc-page-title">📜 Прошлые главы</h1>
      <p class="gc-past-sub">Архив прошлых глав Sunflower Land — сезоны, механики и события</p>
    </div>

    <div class="gc-past-empty">
      <div class="gc-past-empty-icon">🚧</div>
      <div class="gc-past-empty-title">Скоро здесь появится история</div>
      <p class="gc-past-empty-desc">
        Список прошлых глав ещё собирается — загляните позже.
      </p>
    </div>

  </div>
</BaseLayout>

<style>
.gc-past-back {
  display: inline-flex;
  margin: 20px 0 0;
}
.gc-past-header { padding: 24px 0; }
.gc-past-sub { font-size: 15px; color: var(--text-sec); margin-top: 6px; }

.gc-past-empty {
  padding: 64px 32px;
  text-align: center;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 14px;
  margin-bottom: 48px;
}
.gc-past-empty-icon { font-size: 32px; margin-bottom: 12px; }
.gc-past-empty-title {
  font-family: var(--font-head);
  font-size: 16px;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 8px;
}
.gc-past-empty-desc {
  font-size: 13.5px;
  color: var(--text-sec);
  max-width: 420px;
  margin: 0 auto;
  line-height: 1.6;
}
</style>
