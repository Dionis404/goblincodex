---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sectionHref } from '../lib/subdomains';
import { getCollection } from 'astro:content';

// Ссылки на разделы — абсолютные на поддомен, когда поддомены включены
// (см. src/lib/subdomains.ts), иначе обычные относительные пути.
const host = Astro.request.headers.get('host');
const newsHref = sectionHref(host, 'blog', '/news');
const codexHref = sectionHref(host, 'sfl', '/codex');
const yakkamonHref = sectionHref(host, 'yakk', '/yakkamon');

const latestGuides = await getCollection('guides', ({ data }) => !data.draft);
latestGuides.sort((a, b) => new Date(b.data.publishDate ?? '').getTime() - new Date(a.data.publishDate ?? '').getTime());

const allMechanics = await getCollection('mechanics', ({ data }) => !data.draft).catch(() => []);
const articlesCount = latestGuides.length + allMechanics.length;

const newestDate = [...latestGuides, ...allMechanics].reduce((max, item) => {
  const d = new Date(item.data.updatedDate ?? item.data.publishDate ?? 0);
  return d > max ? d : max;
}, new Date(0));
const updatedLabel = (newestDate.getTime() > 0 ? newestDate : new Date())
  .toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  currentPage="home"
  title="GoblinCodex — гайды по Sunflower Land"
  description="Русскоязычный хаб для игроков Sunflower Land: гайды для новичков, разборы механик, каталог NFT предметов с бустами."
>

  <div class="gc-content">

    <!-- ── Hero ── -->
    <section class="gc-hub-hero gc-page-enter">
      <div class="gc-hub-hero-icon">🧙</div>
      <div class="gc-hub-hero-eyebrow">Usual.Routine.Goblin</div>
      <h1 class="gc-hub-hero-h1">Независимые гайды и новости по любимым играм</h1>
      <p class="gc-hub-hero-desc">Гайды по Sunflower Land и Yakkamon, новости обеих игр и блог сообщества.</p>
      <div class="gc-hub-hero-meta">{articlesCount} гайдов, обновлено {updatedLabel}</div>
    </section>

    <!-- ── Плитки разделов ── -->
    <div class="gc-hub-tiles">
      <a href={codexHref} class="gc-hub-tile gc-hub-tile--sfl">
        <div class="gc-hub-tile-sfl-art">
          <img src="/images/UsualGoblin.png" class="gc-hub-tile-sfl-img gc-hub-tile-sfl-img--light" alt="Sunflower Land" />
          <img src="/images/UsualGoblinNight.png" class="gc-hub-tile-sfl-img gc-hub-tile-sfl-img--dark" alt="Sunflower Land" />
        </div>
        <div class="gc-hub-tile-sfl-body">
          <div class="gc-hub-tile-sfl-title">Sunflower Land</div>
          <p class="gc-hub-tile-sfl-desc">Гайды по механикам, кодекс предметов, инструменты и календарь ивентов.</p>
          <div class="gc-hub-tile-sfl-cta">Открыть раздел →</div>
        </div>
      </a>

      <div class="gc-hub-tiles-side">
        <a href={yakkamonHref} class="gc-hub-tile-compact gc-hub-tile--yk">
          <img src="/images/yakkamon-egg.png" class="gc-hub-tile-compact-img" alt="Yakkamon" />
          <div class="gc-hub-tile-compact-body">
            <div class="gc-hub-tile-compact-badge gc-hub-tile-compact-badge--yk">Новый проект</div>
            <div class="gc-hub-tile-compact-title gc-hub-tile-compact-title--yk">Yakkamon</div>
            <p class="gc-hub-tile-compact-desc">Idle-фарминг и коллекционирование существ.</p>
          </div>
        </a>

        <a href={newsHref} class="gc-hub-tile-compact gc-hub-tile--news">
          <img src="/images/news-scroll.png" class="gc-hub-tile-compact-img" alt="Новости и блог" />
          <div class="gc-hub-tile-compact-body">
            <div class="gc-hub-tile-compact-live"><span class="gc-hub-tile-live-dot"></span>Живая лента</div>
            <div class="gc-hub-tile-compact-title">Новости и блог</div>
            <p class="gc-hub-tile-compact-desc">Общая лента обновлений по обеим играм и авторский блог о сообществе, с фильтром по проекту.</p>
          </div>
        </a>
      </div>
    </div>

    <!-- ── Нижний ряд ссылок ── -->
    <div class="gc-hub-links">
      <a href="/about" class="gc-hub-link">О проекте</a>
      <a href="/community" class="gc-hub-link">Сообщество</a>
      <a href="/donate" class="gc-hub-link gc-hub-link--cta">Поддержать проект</a>
    </div>

  </div>
</BaseLayout>

<style>
.gc-hub-hero {
  max-width: 620px;
  margin: 0 auto 44px;
  padding: 40px 20px 0;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.gc-hub-hero-icon {
  width: 48px;
  height: 48px;
  border-radius: 13px;
  background: var(--green-dark);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  margin-bottom: 16px;
}
.gc-hub-hero-eyebrow {
  display: inline-block;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--green-dark);
  background: var(--green-pale);
  padding: 4px 11px;
  border-radius: 99px;
  margin-bottom: 14px;
}
.gc-hub-hero-h1 {
  font-family: var(--font-head);
  font-size: 34px;
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.03em;
  margin: 0 0 12px;
  color: var(--text);
}
.gc-hub-hero-desc {
  font-size: 15px;
  line-height: 1.6;
  color: var(--text-sec);
  margin: 0 0 10px;
}
.gc-hub-hero-meta {
  font-size: 12px;
  color: var(--text-ter);
  margin: 0;
}

/* ── Плитки разделов ── */
.gc-hub-tiles {
  display: flex;
  flex-wrap: wrap;
  gap: 22px;
  margin-bottom: 48px;
  align-items: stretch;
}
.gc-hub-tile--sfl {
  flex: 2 1 380px;
  display: flex;
  flex-direction: column;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
  text-decoration: none;
  transition: transform 0.18s, box-shadow 0.18s, border-color 0.18s;
}
.gc-hub-tile--sfl:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 32px rgba(0,0,0,0.16);
  border-color: var(--green-dark);
}
.gc-hub-tile-sfl-art {
  position: relative;
  width: 100%;
  height: 230px;
  overflow: hidden;
}
.gc-hub-tile-sfl-img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.gc-hub-tile-sfl-img--dark { display: none; }
[data-theme="dark"] .gc-hub-tile-sfl-img--light { display: none; }
[data-theme="dark"] .gc-hub-tile-sfl-img--dark  { display: block; }
.gc-hub-tile-sfl-body {
  padding: 26px 28px 28px;
  display: flex;
  flex-direction: column;
  gap: 11px;
  flex: 1;
}
.gc-hub-tile-sfl-title {
  font-family: var(--font-head);
  font-size: 22px;
  font-weight: 700;
  color: var(--green-dark);
}
.gc-hub-tile-sfl-desc {
  font-size: 14px;
  line-height: 1.6;
  color: var(--text-sec);
  margin: 0;
  flex: 1;
}
.gc-hub-tile-sfl-cta {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13.5px;
  font-weight: 600;
  color: var(--green-dark);
  margin-top: 4px;
}

.gc-hub-tiles-side {
  flex: 1 1 280px;
  display: flex;
  flex-direction: column;
  gap: 22px;
}
.gc-hub-tile-compact {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 14px;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 16px;
  overflow: hidden;
  text-decoration: none;
  transition: transform 0.18s, box-shadow 0.18s, border-color 0.18s;
}
.gc-hub-tile-compact:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 24px rgba(0,0,0,0.14);
}
.gc-hub-tile--yk:hover { border-color: var(--yk-accent-mid); }
.gc-hub-tile--news:hover { border-color: var(--text-sec); }
.gc-hub-tile--yk {
  --yk-accent-mid: #2F7C8C;
  --yk-accent-pale: rgba(47,124,140,0.12);
}
[data-theme="dark"] .gc-hub-tile--yk {
  --yk-accent-mid: #5FA9BA;
  --yk-accent-pale: rgba(95,169,186,0.16);
}

.gc-hub-tile-compact-img {
  width: 74px;
  height: 74px;
  flex-shrink: 0;
  border-radius: 10px;
  object-fit: contain;
  image-rendering: pixelated;
  background: var(--bg);
}
.gc-hub-tile-compact-body { flex: 1; min-width: 0; }
.gc-hub-tile-compact-badge {
  display: inline-block;
  font-size: 9.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  padding: 2px 8px;
  border-radius: 99px;
  margin-bottom: 5px;
}
.gc-hub-tile-compact-badge--yk {
  color: var(--yk-accent-mid);
  background: var(--yk-accent-pale);
}
.gc-hub-tile-compact-title {
  font-family: var(--font-head);
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 3px;
}
.gc-hub-tile-compact-title--yk { color: var(--yk-accent-mid); }
.gc-hub-tile-compact-desc {
  font-size: 12px;
  line-height: 1.4;
  color: var(--text-sec);
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.gc-hub-tile-compact-live {
  display: flex;
  align-items: center;
  gap: 5px;
  margin-bottom: 5px;
  font-size: 9.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--text-sec);
}
.gc-hub-tile-live-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--green-dark);
  flex-shrink: 0;
}

/* ── Нижний ряд ссылок ── */
.gc-hub-links {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  justify-content: center;
  margin-bottom: 40px;
}
.gc-hub-link {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-sec);
  border: 1.5px solid var(--border);
  padding: 10px 20px;
  border-radius: 9px;
  transition: border-color 0.15s, background 0.15s, color 0.15s;
}
.gc-hub-link:hover {
  border-color: var(--green-mid);
  background: var(--green-pale);
  color: var(--green-dark);
}
.gc-hub-link--cta {
  font-weight: 700;
  color: #2B1D0A;
  background: var(--amber);
  border-color: var(--amber);
}
.gc-hub-link--cta:hover { filter: brightness(1.06); }

@media (max-width: 900px) {
  .gc-hub-tiles { flex-direction: column; }
  .gc-hub-tile--sfl { flex-basis: auto; }
  .gc-hub-tiles-side { flex-basis: auto; flex-direction: row; }
  .gc-hub-tile-compact { flex: 1 1 0; }
}
@media (max-width: 640px) {
  .gc-hub-hero-h1 { font-size: 26px; }
  .gc-hub-tiles-side { flex-direction: column; }
  .gc-hub-tile-sfl-art { height: 180px; }
  .gc-hub-tile-compact { flex: none; flex-direction: row; align-items: center; text-align: left; }
  .gc-hub-tile-compact-img { width: 56px; height: 56px; }
}
</style>
