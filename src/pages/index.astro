---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChapterTimer from '../components/ChapterTimer.tsx';

// ── RSS fetch ──
const RSS_URL = 'https://blog.goblincodex.fun/data/rss';

// Цвета тегов по категории
const tagColors: Record<string, string> = {
  'Стримы':      'purple',
  'Обновление':  'blue',
  'Гайд':        'green',
  'Экономика':   'amber',
  'Ивент':       'amber',
  'Контент':     'green',
};

type NewsItem = {
  title: string;
  date: string;
  tag: string;
  tagColor: string;
  link: string;
  image: string;
};

let news: NewsItem[] = [];

try {
  const res  = await fetch(RSS_URL);
  const xml  = await res.text();

  // Парсим items из XML
  const items = xml.match(/<item>([\s\S]*?)<\/item>/g) || [];

  news = items.slice(0, 4).map(item => {
    const title    = item.match(/<title>([\s\S]*?)<\/title>/)?.[1]?.trim() ?? '';
    const link     = item.match(/<link>([\s\S]*?)<\/link>/)?.[1]?.trim() ?? '#';
    const pubDate  = item.match(/<pubDate>([\s\S]*?)<\/pubDate>/)?.[1]?.trim() ?? '';
    const category = item.match(/<category>([\s\S]*?)<\/category>/)?.[1]?.trim() ?? 'Новость';
    const image    = item.match(/media:content[^>]*url="([^"]+)"/)?.[1] ?? '';

    // Форматируем дату
    const date = pubDate
      ? new Date(pubDate).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })
      : '';

    return {
      title,
      date,
      tag: category,
      tagColor: tagColors[category] ?? 'green',
      link,
      image,
    };
  });
} catch (e) {
  // Fallback если RSS недоступен
  news = [
    { title: 'Загрузка новостей...', date: '', tag: '', tagColor: 'green', link: '/news', image: '' },
  ];
}

import { getCollection } from 'astro:content';

const latestGuides = await getCollection('guides', ({ data }) => !data.draft);
latestGuides.sort((a, b) => new Date(b.data.publishDate ?? '').getTime() - new Date(a.data.publishDate ?? '').getTime());
const guides = latestGuides.slice(0, 3).map(g => ({
  title: g.data.title,
  time:  `${g.data.readTime} мин`,
  link:  `/codex/${g.id}`,
  icon:  g.data.icon,
}));
---

<BaseLayout
  currentPage="home"
  title="GoblinCodex — гайды по Sunflower Land"
  description="Русскоязычный хаб для игроков Sunflower Land: гайды для новичков, разборы механик, каталог NFT предметов с бустами."
>

  <!-- ── Hero ── -->
  <section class="gc-hero gc-page-enter">
    <div class="gc-hero-text">
      <h1 class="gc-h1">
        Всё о <em>Sunflower<br/>Land</em> здесь
      </h1>
      <p class="gc-hero-desc">
        Лаконичные гайды, актуальные новости, инструменты и база данных для фермеров SFL.
      </p>
      <div class="gc-hero-actions">
        <a href="/codex" class="gc-btn-primary">📖 Быстрый старт</a>
        <a href="/news" class="gc-btn-secondary">Что нового?</a>
      </div>
    </div>
    <div class="gc-hero-art">
      <div class="gc-farm-frame">
        <img src="/images/UsualGoblin.png" alt="Гоблин фермер" class="gc-hero-img gc-hero-img--light" />
        <img src="/images/UsualGoblinNight.png" alt="Гоблин фермер" class="gc-hero-img gc-hero-img--dark" />
      </div>
    </div>
  </section>

  <div class="gc-content">

    <!-- ── Блок главы + таймер ── -->
    <div class="gc-chapter-block">
      <a href="/chapter" class="gc-chapter-banner">
        <img src="/images/Chapter14.png" alt="The Salt Awakening — Chapter 14" class="gc-chapter-img gc-chapter-img--light" />
        <img src="/images/Chapter14Night.png" alt="The Salt Awakening — Chapter 14" class="gc-chapter-img gc-chapter-img--dark" />
      </a>
      <div class="gc-chapter-timer">
        <ChapterTimer client:load />
        <a href="/chapter" class="gc-btn-cta">Узнать больше</a>
      </div>
    </div>

    <!-- ── 4 карточки разделов ── -->
    <div class="gc-grid-4" style="margin-bottom: 40px;">
      <a href="/codex" class="gc-card gc-card-hover gc-section-card">
        <div class="gc-section-icon">📚</div>
        <div>
          <div class="gc-section-title">Кодекс</div>
          <div class="gc-section-desc">Гайды и разборы механик для всех уровней</div>
        </div>
      </a>
      <a href="/news" class="gc-card gc-card-hover gc-section-card">
        <div class="gc-section-icon">📰</div>
        <div>
          <div class="gc-section-title">Новости и обновления</div>
          <div class="gc-section-desc">Будь в курсе последних изменений в SFL</div>
        </div>
      </a>
      <a href="/tools" class="gc-card gc-card-hover gc-section-card">
        <div class="gc-section-icon">🔧</div>
        <div>
          <div class="gc-section-title">Инструменты</div>
          <div class="gc-section-desc">Калькуляторы и полезные утилиты</div>
        </div>
      </a>
      <a href="/community" class="gc-card gc-card-hover gc-section-card">
        <div class="gc-section-icon">👥</div>
        <div>
          <div class="gc-section-title">Сообщество</div>
          <div class="gc-section-desc">База фермеров и чат нашей банды</div>
        </div>
      </a>
    </div>

    <!-- ── 3 колонки ── -->
    <div class="gc-grid-3c" style="margin-bottom: 40px;">

      <!-- Новости из RSS -->
      <div class="gc-card" style="padding: 24px;">
        <div class="gc-block-header">
          <span class="gc-block-title">🔥 Что нового в SFL</span>
          <a href="/news" class="gc-block-link">Все новости →</a>
        </div>
        <div class="gc-news-list">
          {news.map(item => (
            <a href={item.link} target="_blank" rel="noopener" class="gc-list-item gc-news-item">
              <div class="gc-news-dot"></div>
              <div>
                <div class="gc-news-title">{item.title}</div>
                <div class="gc-news-meta">
                  {item.date}
                  {item.tag && <span class={`gc-tag gc-tag--${item.tagColor}`}>{item.tag}</span>}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Гайды -->
      <div class="gc-card" style="padding: 24px;">
        <div class="gc-block-header">
          <span class="gc-block-title">📗 Последние гайды</span>
          <a href="/codex" class="gc-block-link">Все гайды →</a>
        </div>
        <div>
          {guides.map(guide => (
            <a href={guide.link} class="gc-guide-item">
              <div class="gc-guide-icon">{guide.icon}</div>
              <div>
                <div class="gc-guide-title">{guide.title}</div>
                <div class="gc-guide-time">{guide.time}</div>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Каналы -->
      <div class="gc-card gc-channels-card" style="padding: 24px;">
        <div class="gc-channels-header">
          <span class="gc-channels-dot"></span>
          <span class="gc-channels-title">Наши каналы</span>
        </div>
        <p class="gc-channels-sub">Подписывайся чтобы не пропускать обновления</p>

        <div class="gc-channel-item gc-channel-item--tg">
          <div class="gc-channel-logo gc-channel-logo--tg">✈</div>
          <div class="gc-channel-info">
            <div class="gc-channel-name">Telegram канал</div>
            <div class="gc-channel-desc">Новости, обновления, гайды</div>
          </div>
          <a href="https://t.me/URGSFL" target="_blank" class="gc-channel-link gc-channel-link--tg">Подписаться →</a>
        </div>

        <div class="gc-channel-item gc-channel-item--yt">
          <div class="gc-channel-logo gc-channel-logo--yt">▶</div>
          <div class="gc-channel-info">
            <div class="gc-channel-name">YouTube</div>
            <div class="gc-channel-desc">Видеогайды и разборы</div>
          </div>
          <a href="https://www.youtube.com/@usual.routine.goblin" target="_blank" class="gc-channel-link gc-channel-link--yt">Подписаться →</a>
        </div>

        <div class="gc-channels-stats">
          <div class="gc-stat-card">
            <div class="gc-stat-icon">👥</div>
            <div class="gc-stat-num">1 284</div>
            <div class="gc-stat-label">подписчиков</div>
          </div>
          <div class="gc-stat-card">
            <div class="gc-stat-icon">📝</div>
            <div class="gc-stat-num">48</div>
            <div class="gc-stat-label">статей</div>
          </div>
        </div>
      </div>

    </div>

    <!-- ── CTA баннер ── -->
    <div class="gc-cta-banner">
      <div>
        <div class="gc-cta-title">🌻 Присоединяйся к сообществу фермеров!</div>
        <div class="gc-cta-desc">Общайся, делись опытом и развивай свою ферму вместе с нами</div>
      </div>
      <a href="https://t.me/URGSFL" target="_blank" class="gc-btn-cta">Открыть чат →</a>
    </div>

  </div>

</BaseLayout>

<style>
.gc-hero-desc {
  font-size: 16px;
  line-height: 1.6;
  color: var(--text-sec);
  margin-bottom: 28px;
  max-width: 480px;
}
.gc-hero-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}
.gc-hero-img {
  display: block;
  width: 100%;
  height: auto;
  object-fit: cover;
}
.gc-hero-img--dark { display: none; }
:global([data-theme="dark"]) .gc-hero-img--light { display: none; }
:global([data-theme="dark"]) .gc-hero-img--dark  { display: block; }

:global(.gc-chapter-img) {
  width: 100%;
  height: auto;
  display: block;
  image-rendering: pixelated;
}
:global(.gc-chapter-img--dark)  { display: none; }
:global([data-theme="dark"]) :global(.gc-chapter-img--light) { display: none; }
:global([data-theme="dark"]) :global(.gc-chapter-img--dark)  { display: block; }

.gc-chapter-block {
  position: relative;
  margin-bottom: 32px;
}
.gc-chapter-banner {
  display: block;
  width: 100%;
  line-height: 0;
  filter: drop-shadow(0 8px 24px rgba(0,0,0,0.25));
  position: relative;
  z-index: 2;
}
:global(.gc-chapter-timer) {
  background: #5C3D1E;
  border-radius: 14px;
  padding: 20px 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  max-width: 75%;
  margin: -20px auto 0;
  position: relative;
  z-index: 1;
  box-shadow: 0 4px 16px rgba(0,0,0,0.3);
}
:global(.gc-timer-row) {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15px;
  flex: 1;
  padding-top: 10px;
}
:global(.gc-timer-label) {
  font-size: 15px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: rgba(255,255,255,0.5);
  text-align: center;
  font-family: 'Press Start 2P', monospace;
}
:global(.gc-timer-digits) {
  display: flex;
  align-items: baseline;
  gap: 8px;
  justify-content: center;
}
:global(.gc-timer-value) {
  font-family: 'Press Start 2P', monospace;
  font-size: 28px;
  color: #e8ece3;
  letter-spacing: 3px;
}

/* Новости — ссылки */
.gc-news-item {
  text-decoration: none;
  color: inherit;
  display: flex;
  transition: padding-left 0.15s;
}
.gc-news-item:hover { padding-left: 4px; }
.gc-news-item:hover .gc-news-title { color: var(--green-dark); }
</style>
