---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  currentPage?: string;
}

const {
  title = 'GoblinCodex — Всё о Sunflower Land',
  description = 'Гайды, новости, калькуляторы и база данных фермеров по игре Sunflower Land',
  currentPage = 'home'
} = Astro.props;
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;500;600;700&family=Golos+Text:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header currentPage={currentPage} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
