# Данные для PostgreSQL
POSTGRES_DB=sfl
POSTGRES_USER=goblin
POSTGRES_PASSWORD=your_password_here

# Строка подключения для Prisma. Сайт читает общую БД sfl на postgres-main
# (таблицы telegram_posts, telegram_stats, sfl_items и др.) —
# @postgres-main — имя контейнера в docker-сети shared-net, не localhost!
DATABASE_URL=postgresql://goblin:your_password_here@postgres-main:5432/sfl

# Окружение
NODE_ENV=production
# Telegram Bot API (для счётчика подписчиков канала)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram-чат для уведомлений о негативных оценках поиска (тот же ADMIN_TELEGRAM_IDS, что у goblin-bot)
ADMIN_TELEGRAM_ID=your_admin_chat_id_here

# routerai.ru — API-ключ для эмбеддингов (семантический поиск по гайдам/механикам)
ROUTERAI_API_KEY=your_routerai_api_key_here

# Единый API данных SFL (репо Dionis404/sfl-collector, сервис sfl-api):
# фермеры сообщества, лидерборд тикетов, аукционы, цены ресурсов, кэш ферм.
# Доступен только внутри shared-net, сайт ходит в него с SSR.
SFL_API_URL=http://sfl-api:8000

# Базовый URL прокси данных ферм для браузера (astro-роут /api/farms) — по умолчанию /api
PUBLIC_API_BASE=/api
