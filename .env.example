# Данные для PostgreSQL
POSTGRES_DB=goblincodex
POSTGRES_USER=goblin
POSTGRES_PASSWORD=your_password_here

# Строка подключения для Prisma
# @postgres — это имя контейнера в docker-compose, не localhost!
DATABASE_URL=postgresql://goblin:your_password_here@postgres:5432/goblincodex

# Окружение
NODE_ENV=production
# Telegram Bot API (для счётчика подписчиков канала)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram-чат для уведомлений о негативных оценках поиска (тот же ADMIN_TELEGRAM_IDS, что у goblin-bot)
ADMIN_TELEGRAM_ID=your_admin_chat_id_here

# routerai.ru — API-ключ для эмбеддингов (семантический поиск по гайдам/механикам)
ROUTERAI_API_KEY=your_routerai_api_key_here

# Базовый URL API данных ферм (goblin-api), проксируемого через /api/farm/* — по умолчанию /api
PUBLIC_API_BASE=/api
